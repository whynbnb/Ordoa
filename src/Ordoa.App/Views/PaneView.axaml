<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Ordoa.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ordoa.App.ViewModels"
             xmlns:models="using:Ordoa.Core.Models"
             xmlns:views="using:Ordoa.App.Views"
             x:DataType="vm:PaneViewModel"
             x:CompileBindings="True"
             x:Class="Ordoa.App.Views.PaneView"
             x:Name="Root"
             Background="{DynamicResource SurfaceBrush}">
  <UserControl.Styles>
    <Style Selector="Button.crumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.crumb:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.header:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.header:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.columnvalue">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ListBox.files ListBoxItem">
      <Setter Property="MinHeight" Value="33" />
      <Setter Property="CornerRadius" Value="5" />
      <!-- Match the header's horizontal padding so both grids share the same
           width and every column starts at the same x position. -->
      <Setter Property="Margin" Value="16,1,14,1" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Grid.rownarrow">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.narrow Grid.rownarrow">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBox.narrow Grid.rowwide">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel.fileitem.dim">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="StackPanel.filetile.dim">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="Panel.fileitem.gitignored">
      <Setter Property="Opacity" Value="0.76" />
    </Style>
    <Style Selector="StackPanel.filetile.gitignored">
      <Setter Property="Opacity" Value="0.76" />
    </Style>
    <Style Selector="Panel.fileitem.dim.gitignored">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="StackPanel.filetile.dim.gitignored">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Border.colgrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector="Border.colgrip:pointerover">
      <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="Border.colresize">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="Border.colresize:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.files.densitycompact ListBoxItem">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Margin" Value="16,0,14,0" />
    </Style>
    <Style Selector="ListBox.files.densityspacious ListBoxItem">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Margin" Value="16,2,14,2" />
    </Style>
    <Style Selector="Border.groupheaderrow">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Margin" Value="0,7,0,2" />
    </Style>
    <Style Selector="TextBlock.groupheadertitle">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.sortbadge">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
        <Flyout x:Key="SearchFlyout" Placement="BottomEdgeAlignedRight">
          <StackPanel Width="300" Spacing="8" x:CompileBindings="True" x:DataType="vm:PaneViewModel">
            <TextBlock Text="{loc:Tr 搜索语法}" Classes="h2" />
            <TextBlock Classes="fieldhint" Text="{loc:Tr 普通词匹配文件名；多个词需同时匹配。}"
                       TextWrapping="Wrap" />
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="5" Padding="8,6">
              <StackPanel Spacing="3">
                <TextBlock Text="*.cs -node_modules size:&gt;10MB" Classes="tiny" FontFamily="monospace" />
                <TextBlock Text="content:TODO modified:&gt;7d ext:cs,json" Classes="tiny" FontFamily="monospace" />
                <TextBlock Text="type:image size:&lt;2MB modified:today" Classes="tiny" FontFamily="monospace" />
              </StackPanel>
            </Border>
            <TextBlock Classes="fieldhint" Text="{loc:Tr 支持 glob、排除项 -词、ext:、type:、size:、modified:、content:、tag: 和 color:；使用引号包含空格。}"
                       TextWrapping="Wrap" />

            <Border Classes="divider" />
            <Button Content="{loc:Tr 保存当前搜索…}" Classes="ghost" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Click="OnSaveSearchClick" />
            <CheckBox Content="{loc:Tr 搜索整个磁盘}" IsChecked="{Binding SearchWholeDisk, Mode=TwoWay}"
                      ToolTip.Tip="{loc:Tr 从文件系统根目录开始搜索，可能较慢}" />

            <Border Classes="divider" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr 最近搜索}" Classes="section" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Padding="6,2" FontSize="11"
                      Content="{loc:Tr 清空}" Click="OnClearSearchHistoryClick"
                      IsVisible="{Binding HasSearchHistory}" />
            </Grid>
            <TextBlock Text="{loc:Tr 暂无搜索历史}" Classes="fieldhint"
                       IsVisible="{Binding !HasSearchHistory}" />
            <ItemsControl ItemsSource="{Binding SearchHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="6,3" FontSize="12" Content="{Binding}" Tag="{Binding}"
                          Click="OnHistorySearchClick" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="divider" />
            <TextBlock Text="{loc:Tr 保存的搜索}" Classes="section" />
            <TextBlock Text="{loc:Tr 暂无保存的搜索}" Classes="fieldhint"
                       IsVisible="{Binding !HasSavedSearches}" />
            <ItemsControl ItemsSource="{Binding SavedSearches}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:SavedSearch">
                  <Grid ColumnDefinitions="*,Auto">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="6,2" FontSize="12" Content="{Binding Name}" Tag="{Binding Query}"
                            ToolTip.Tip="{Binding Query}" Click="OnHistorySearchClick" />
                    <Button Grid.Column="1" Classes="tool" Width="20" Height="20" Padding="0"
                            ToolTip.Tip="{loc:Tr 删除}" Tag="{Binding}" Click="OnDeleteSavedSearchClick">
                      <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stretch="Uniform"
                            Fill="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Flyout>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Active-pane indicator: only shown while the tab is split. -->
    <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" ZIndex="20"
            IsVisible="{Binding ShowsActiveBar}" />

    <!-- Toolbar -->
    <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="7,5">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="2">
        <Button Classes="tool" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}"
                ToolTip.Tip="{loc:Tr 后退 (Alt+←)}">
          <Path Data="{StaticResource IconBack}" Width="15" Height="15" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>
        <Button Grid.Column="1" Classes="tool" Command="{Binding GoForwardCommand}"
                IsEnabled="{Binding CanGoForward}" ToolTip.Tip="{loc:Tr 前进 (Alt+→)}">
          <Path Data="{StaticResource IconForward}" Width="15" Height="15" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>
        <Button Grid.Column="2" Classes="tool" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}"
                ToolTip.Tip="{loc:Tr 上一级 (Alt+↑)}">
          <Path Data="{StaticResource IconUp}" Width="15" Height="15" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>
        <Button Grid.Column="3" Classes="tool" Command="{Binding RefreshCommand}"
                ToolTip.Tip="{loc:Tr 刷新 (F5)}">
          <Path Data="{StaticResource IconRefresh}" Width="14" Height="14" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>

        <Border Grid.Column="4" Background="Transparent" Margin="5,0,6,0" MinHeight="28"
                DoubleTapped="OnBreadcrumbDoubleTapped">
          <Grid>
            <ScrollViewer x:Name="BreadcrumbScroller" IsVisible="{Binding !IsNarrow}"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BreadcrumbItem">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Classes="crumb" Click="OnBreadcrumbClick" ToolTip.Tip="{Binding Path}">
                        <TextBlock Text="{Binding Label}" FontSize="12" MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Button>
                      <Path Data="{StaticResource IconChevronRight}" Width="10" Height="10" Stretch="Uniform"
                            Fill="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,0"
                            IsVisible="{Binding IsLast, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Button Classes="crumb" IsVisible="{Binding IsNarrow}" Click="OnCompactBreadcrumbClick"
                    HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="{Binding DisplayPath}">
              <TextBlock Text="{Binding Title}" FontSize="12" MaxWidth="160"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Button>

            <TextBox x:Name="LocationBox" Classes="path" Text="{Binding LocationText, Mode=TwoWay}"
                     IsVisible="{Binding IsEditingLocation}" KeyDown="OnLocationKeyDown"
                     LostFocus="OnLocationLostFocus" FontSize="12.5" MinHeight="26" Padding="5,3"
                     PlaceholderText="{loc:Tr 输入路径或远程地址}" />
          </Grid>
        </Border>

        <Button Grid.Column="4" Classes="tool" Width="24" Height="24" Margin="0,0,2,0"
                IsVisible="{Binding !IsNarrow}" HorizontalAlignment="Right" VerticalAlignment="Center"
                Click="OnEditPathClick" ToolTip.Tip="{loc:Tr 编辑路径 (Ctrl+L)}">
          <Path Data="{StaticResource IconRename}" Width="11" Height="11" Stretch="Uniform"
                Fill="{DynamicResource TextTertiaryBrush}" />
        </Button>

        <Grid Grid.Column="5" Width="160" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" Classes="search" Text="{Binding FilterText, Mode=TwoWay}"
                   Padding="26,4,26,4" MinHeight="28" KeyDown="OnSearchKeyDown"
                   PlaceholderText="{loc:Tr 搜索}" ToolTip.Tip="{loc:Tr 输入以过滤；按 Enter 进行深度搜索}" />
          <Path Data="{StaticResource IconSearch}" Width="13" Height="13" Stretch="Uniform"
                Fill="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Left"
                VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
          <Button Classes="tool" Width="20" Height="20" Padding="0" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Margin="0,0,2,0"
                  Flyout="{StaticResource SearchFlyout}"
                  ToolTip.Tip="{loc:Tr 搜索语法、历史与保存的搜索}">
            <Path Data="{StaticResource IconChevronDown}" Width="10" Height="10" Stretch="Uniform"
                  Fill="{DynamicResource TextTertiaryBrush}" />
          </Button>
        </Grid>

        <Button Grid.Column="6" Classes="tool" Command="{Binding ToggleViewCommand}"
                IsVisible="{Binding !IsNarrow}" ToolTip.Tip="{Binding ViewTooltip}">
          <Path Data="{Binding ViewIcon}" Width="14" Height="14" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>

        <Button Grid.Column="7" Classes="tool" IsVisible="{Binding !IsNarrow}"
                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleSplitCommand}"
                ToolTip.Tip="{loc:Tr 分屏 (Ctrl+\)}">
          <Path Data="{StaticResource IconSplit}" Width="14" Height="14" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>

        <Button Grid.Column="8" Classes="tool" ToolTip.Tip="{loc:Tr 更多操作}">
          <Path Data="{StaticResource IconDots}" Width="15" Height="15" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{loc:Tr 排序}">
                <MenuItem Header="{loc:Tr 名称}" Click="OnSortNameClick" />
                <MenuItem Header="{loc:Tr 大小}" Click="OnSortSizeClick" />
                <MenuItem Header="{loc:Tr 修改时间}" Click="OnSortModifiedClick" />
                <MenuItem Header="{loc:Tr 类型}" Click="OnSortTypeClick" />
                <Separator />
                <MenuItem Header="{loc:Tr 文件夹优先}" Click="OnToggleFoldersFirstClick" />
              </MenuItem>
              <MenuItem Header="{loc:Tr 分组}">
                <MenuItem Header="{loc:Tr 不分组}" Click="OnGroupNoneClick" />
                <MenuItem Header="{loc:Tr 按类型}" Click="OnGroupTypeClick" />
                <MenuItem Header="{loc:Tr 按修改时间}" Click="OnGroupModifiedClick" />
                <MenuItem Header="{loc:Tr 按大小}" Click="OnGroupSizeClick" />
              </MenuItem>
              <MenuItem Header="{loc:Tr 网格缩略图}">
                <MenuItem Header="{loc:Tr 小}" Click="OnGridSmallClick" />
                <MenuItem Header="{loc:Tr 中}" Click="OnGridMediumClick" />
                <MenuItem Header="{loc:Tr 大}" Click="OnGridLargeClick" />
              </MenuItem>
              <MenuItem Header="{loc:Tr 列表行高}">
                <MenuItem Header="{loc:Tr 紧凑}" Click="OnDensityCompactClick" />
                <MenuItem Header="{loc:Tr 标准}" Click="OnDensityNormalClick" />
                <MenuItem Header="{loc:Tr 宽松}" Click="OnDensitySpaciousClick" />
              </MenuItem>
              <MenuItem Header="{loc:Tr 显示/隐藏标签列}" Click="OnToggleTagsColumnClick" />
              <MenuItem Header="{loc:Tr 新建文件夹}" Click="OnNewFolderClick" />
              <MenuItem Header="{loc:Tr 新建空文件}" Click="OnNewFileClick" />
              <MenuItem Header="{loc:Tr 粘贴}" Click="OnPasteClick" />
              <MenuItem Header="{loc:Tr 复制到…}" Click="OnCopyToClick" />
              <MenuItem Header="{loc:Tr 移动到…}" Click="OnMoveToClick" />
              <MenuItem Header="{loc:Tr 粘贴为符号链接}" Click="OnPasteAsLinkClick" />
              <MenuItem Header="{loc:Tr 全选}" Click="OnSelectAllClick" />
              <Separator />
              <MenuItem Header="{loc:Tr 压缩为 ZIP}" Click="OnCompressZipClick" />
              <MenuItem Header="{loc:Tr 压缩为 tar.gz}" Click="OnCompressTarClick" />
              <MenuItem Header="{loc:Tr 压缩为 tar.zst}" Click="OnCompressZstdClick" />
              <MenuItem Header="{loc:Tr 压缩为 tar.xz}" Click="OnCompressXzClick" />
              <MenuItem Header="{loc:Tr 压缩为 7z}" Click="OnCompress7zClick" />
              <MenuItem Header="{loc:Tr 解压到此处}" Click="OnExtractClick" />
              <MenuItem Header="{loc:Tr 计算校验和}" Click="OnChecksumClick" />
              <MenuItem Header="{loc:Tr 分析工具}">
                <MenuItem Header="{loc:Tr 磁盘占用分析}" Click="OnDiskUsageClick" />
                <MenuItem Header="{loc:Tr 查找重复文件}" Click="OnDuplicateFinderClick" />
                <MenuItem Header="{loc:Tr Git 状态}" Click="OnGitStatusClick" />
              </MenuItem>
              <Separator />
              <MenuItem Header="{loc:Tr 切换列表 / 网格}" Click="OnToggleViewClick" />
              <MenuItem Header="{loc:Tr 切换树视图}" Click="OnToggleTreeClick" />
              <MenuItem Header="{loc:Tr 切换 Miller 列视图}" Click="OnToggleMillerClick" />
              <MenuItem Header="{loc:Tr 切换分屏}" Click="OnToggleSplitClick" />
              <MenuItem Header="{loc:Tr 刷新}" Click="OnRefreshClick" />
              <MenuItem Header="{loc:Tr 在终端中打开}" Click="OnOpenTerminalClick" />
              <MenuItem Header="{loc:Tr 复制路径}" Click="OnCopyPathClick" />
              <MenuItem Header="{loc:Tr 属性}" Click="OnPropertiesClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Trash actions -->
    <Border Grid.Row="1" Background="{DynamicResource WarningSoftBrush}" Padding="10,5"
            IsVisible="{Binding IsTrash}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Path Data="{StaticResource IconTrash}" Width="13" Height="13" Stretch="Uniform"
              Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{loc:Tr 回收站中的项目可以恢复；清空后无法撤销。}"
                   Classes="caption" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="{loc:Tr 恢复选中}" Classes="subtle" FontSize="11.5"
                Padding="10,3" Click="OnRestoreClick" IsEnabled="{Binding CanRestore}" />
        <Button Grid.Column="3" Content="{loc:Tr 清空回收站}" Classes="subtle" FontSize="11.5"
                Padding="10,3" Click="OnEmptyTrashClick" IsEnabled="{Binding CanEmptyTrash}" />
      </Grid>
    </Border>

    <!-- Search banner -->
    <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" Padding="10,5"
            IsVisible="{Binding IsSearchActive}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <Path Data="{StaticResource IconSearch}" Width="12" Height="12" Stretch="Uniform"
              Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding SearchStatus}" FontSize="11.5" />
          <TextBlock Text="{Binding FilterText}" FontSize="11" Classes="tiny"
                     TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Width="60" Height="2" IsVisible="{Binding IsSearching}" />
        </StackPanel>
        <Button Grid.Column="2" Content="{Binding SearchScopeText}" Classes="subtle" FontSize="11"
                Padding="8,2" Click="OnToggleSearchScopeClick"
                ToolTip.Tip="{loc:Tr 切换搜索范围并重新搜索}" />
        <TextBlock Grid.Column="3" Text="{Binding DisplayPath}" Classes="tiny" VerticalAlignment="Center"
                   MaxWidth="240" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="4" Classes="tool" Width="22" Height="22" Click="OnExitSearchClick"
                ToolTip.Tip="{loc:Tr 退出搜索}">
          <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>
      </Grid>
    </Border>

    <!-- Files -->
    <Panel Grid.Row="2">
      <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsGrid}">
        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,0,14,0" Height="27">
          <Grid>
          <Grid x:Name="WideHeader" Classes="headerwide" IsVisible="{Binding !IsNarrow}" ColumnDefinitions="*,74,116,88,110,86,92" ColumnSpacing="0">
            <Button Grid.Column="{Binding NameColumnIndex}" Classes="header" Tag="Name" Click="OnSortHeaderClick">
              <Grid ColumnDefinitions="6,*,4">
                <Border Grid.Column="0" Classes="colgrip" Tag="Name" ToolTip.Tip="{loc:Tr 拖动调整列顺序}"
                        PointerPressed="OnColumnReorderPressed" PointerMoved="OnColumnReorderMoved"
                        PointerReleased="OnColumnReorderReleased" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr 名称}" Classes="columnvalue" />
                  <Path Data="{StaticResource IconArrowDown}" Width="9" Height="9" Stretch="Uniform"
                        Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="50%,50%"
                        RenderTransform="{Binding SortDescending, Converter={StaticResource SortArrowConverter}}"
                        IsVisible="{Binding SortColumn, Converter={StaticResource EqualsConverter}, ConverterParameter=Name}" />
                </StackPanel>
                <Border Grid.Column="2" Classes="colresize" Tag="Name"
                        PointerPressed="OnColumnResizePressed" PointerMoved="OnColumnResizeMoved"
                        PointerReleased="OnColumnResizeReleased" DoubleTapped="OnColumnResizeDoubleTapped" />
              </Grid>
            </Button>
            <Button Grid.Column="{Binding SizeColumnIndex}" Classes="header" Tag="Size" Click="OnSortHeaderClick"
                    IsVisible="{Binding ShowSizeColumn}" HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="6,*,4">
                <Border Grid.Column="0" Classes="colgrip" Tag="Size" ToolTip.Tip="{loc:Tr 拖动调整列顺序}"
                        PointerPressed="OnColumnReorderPressed" PointerMoved="OnColumnReorderMoved"
                        PointerReleased="OnColumnReorderReleased" />
                <Grid Grid.Column="1" ColumnDefinitions="*,15" Margin="2,0,0,0">
                  <TextBlock Text="{loc:Tr 大小}" Classes="columnvalue" HorizontalAlignment="Right" />
                  <Path Grid.Column="1" Data="{StaticResource IconArrowDown}" Width="9" Height="9"
                        Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                        RenderTransformOrigin="50%,50%"
                        RenderTransform="{Binding SortDescending, Converter={StaticResource SortArrowConverter}}"
                        IsVisible="{Binding SortColumn, Converter={StaticResource EqualsConverter}, ConverterParameter=Size}" />
                </Grid>
                <Border Grid.Column="2" Classes="colresize" Tag="Size"
                        PointerPressed="OnColumnResizePressed" PointerMoved="OnColumnResizeMoved"
                        PointerReleased="OnColumnResizeReleased" DoubleTapped="OnColumnResizeDoubleTapped" />
              </Grid>
            </Button>
            <Button Grid.Column="{Binding ModifiedColumnIndex}" Classes="header" Tag="Modified" Click="OnSortHeaderClick"
                    IsVisible="{Binding ShowModifiedColumn}">
              <Grid ColumnDefinitions="6,*,4">
                <Border Grid.Column="0" Classes="colgrip" Tag="Modified" ToolTip.Tip="{loc:Tr 拖动调整列顺序}"
                        PointerPressed="OnColumnReorderPressed" PointerMoved="OnColumnReorderMoved"
                        PointerReleased="OnColumnReorderReleased" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr 修改时间}" Classes="columnvalue" />
                  <Path Data="{StaticResource IconArrowDown}" Width="9" Height="9" Stretch="Uniform"
                        Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="50%,50%"
                        RenderTransform="{Binding SortDescending, Converter={StaticResource SortArrowConverter}}"
                        IsVisible="{Binding SortColumn, Converter={StaticResource EqualsConverter}, ConverterParameter=Modified}" />
                </StackPanel>
                <Border Grid.Column="2" Classes="colresize" Tag="Modified"
                        PointerPressed="OnColumnResizePressed" PointerMoved="OnColumnResizeMoved"
                        PointerReleased="OnColumnResizeReleased" DoubleTapped="OnColumnResizeDoubleTapped" />
              </Grid>
            </Button>
            <Button Grid.Column="{Binding TypeColumnIndex}" Classes="header" Tag="Type" Click="OnSortHeaderClick"
                    IsVisible="{Binding ShowTypeColumn}">
              <Grid ColumnDefinitions="6,*,4">
                <Border Grid.Column="0" Classes="colgrip" Tag="Type" ToolTip.Tip="{loc:Tr 拖动调整列顺序}"
                        PointerPressed="OnColumnReorderPressed" PointerMoved="OnColumnReorderMoved"
                        PointerReleased="OnColumnReorderReleased" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr 类型}" Classes="columnvalue" />
                  <Path Data="{StaticResource IconArrowDown}" Width="9" Height="9" Stretch="Uniform"
                        Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="50%,50%"
                        RenderTransform="{Binding SortDescending, Converter={StaticResource SortArrowConverter}}"
                        IsVisible="{Binding SortColumn, Converter={StaticResource EqualsConverter}, ConverterParameter=Type}" />
                </StackPanel>
                <Border Grid.Column="2" Classes="colresize" Tag="Type"
                        PointerPressed="OnColumnResizePressed" PointerMoved="OnColumnResizeMoved"
                        PointerReleased="OnColumnResizeReleased" DoubleTapped="OnColumnResizeDoubleTapped" />
              </Grid>
            </Button>
            <Button Grid.Column="{Binding TagsColumnIndex}" Classes="header" Tag="Tags"
                    IsVisible="{Binding ShowTagsColumn}">
              <Grid ColumnDefinitions="6,*,4">
                <Border Grid.Column="0" Classes="colgrip" Tag="Tags" ToolTip.Tip="{loc:Tr 拖动调整列顺序}"
                        PointerPressed="OnColumnReorderPressed" PointerMoved="OnColumnReorderMoved"
                        PointerReleased="OnColumnReorderReleased" />
                <TextBlock Grid.Column="1" Text="{loc:Tr 标签}" Classes="columnvalue" Margin="2,0,0,0" />
                <Border Grid.Column="2" Classes="colresize" Tag="Tags"
                        PointerPressed="OnColumnResizePressed" PointerMoved="OnColumnResizeMoved"
                        PointerReleased="OnColumnResizeReleased" DoubleTapped="OnColumnResizeDoubleTapped" />
              </Grid>
            </Button>
            <Button Grid.Column="{Binding PermissionsColumnIndex}" Classes="header" Tag="Permissions"
                    Click="OnSortHeaderClick" IsVisible="{Binding ShowPermissionColumn}">
              <Grid ColumnDefinitions="6,*,4">
                <Border Grid.Column="0" Classes="colgrip" Tag="Permissions" ToolTip.Tip="{loc:Tr 拖动调整列顺序}"
                        PointerPressed="OnColumnReorderPressed" PointerMoved="OnColumnReorderMoved"
                        PointerReleased="OnColumnReorderReleased" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr 权限}" Classes="columnvalue" />
                  <Path Data="{StaticResource IconArrowDown}" Width="9" Height="9" Stretch="Uniform"
                        Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="50%,50%"
                        RenderTransform="{Binding SortDescending, Converter={StaticResource SortArrowConverter}}"
                        IsVisible="{Binding SortColumn, Converter={StaticResource EqualsConverter}, ConverterParameter=Permissions}" />
                </StackPanel>
                <Border Grid.Column="2" Classes="colresize" Tag="Permissions"
                        PointerPressed="OnColumnResizePressed" PointerMoved="OnColumnResizeMoved"
                        PointerReleased="OnColumnResizeReleased" DoubleTapped="OnColumnResizeDoubleTapped" />
              </Grid>
            </Button>
            <Button Grid.Column="{Binding OwnerColumnIndex}" Classes="header" Tag="Owner" Click="OnSortHeaderClick"
                    IsVisible="{Binding ShowOwnerColumn}">
              <Grid ColumnDefinitions="6,*,4">
                <Border Grid.Column="0" Classes="colgrip" Tag="Owner" ToolTip.Tip="{loc:Tr 拖动调整列顺序}"
                        PointerPressed="OnColumnReorderPressed" PointerMoved="OnColumnReorderMoved"
                        PointerReleased="OnColumnReorderReleased" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr 所有者}" Classes="columnvalue" />
                  <Path Data="{StaticResource IconArrowDown}" Width="9" Height="9" Stretch="Uniform"
                        Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="50%,50%"
                        RenderTransform="{Binding SortDescending, Converter={StaticResource SortArrowConverter}}"
                        IsVisible="{Binding SortColumn, Converter={StaticResource EqualsConverter}, ConverterParameter=Owner}" />
                </StackPanel>
                <Border Grid.Column="2" Classes="colresize" Tag="Owner"
                        PointerPressed="OnColumnResizePressed" PointerMoved="OnColumnResizeMoved"
                        PointerReleased="OnColumnResizeReleased" DoubleTapped="OnColumnResizeDoubleTapped" />
              </Grid>
            </Button>
          </Grid>
          <Grid Classes="headernarrow" IsVisible="{Binding IsNarrow}" ColumnDefinitions="*,74" ColumnSpacing="0">
            <Button Classes="header" Tag="Name" Click="OnSortHeaderClick">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <TextBlock Text="{loc:Tr 名称}" Classes="columnvalue" />
                <Path Data="{StaticResource IconArrowDown}" Width="9" Height="9" Stretch="Uniform"
                      Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="50%,50%"
                      RenderTransform="{Binding SortDescending, Converter={StaticResource SortArrowConverter}}"
                      IsVisible="{Binding SortColumn, Converter={StaticResource EqualsConverter}, ConverterParameter=Name}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="header" Tag="Size" Click="OnSortHeaderClick"
                    IsVisible="{Binding ShowSizeColumn}" HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="*,15">
                <TextBlock Text="{loc:Tr 大小}" Classes="columnvalue" HorizontalAlignment="Right" />
                <!-- Reserve the right margin as the sort-arrow slot so the
                     right-aligned label never shifts when sorting by size. -->
                <Path Grid.Column="1" Data="{StaticResource IconArrowDown}" Width="9" Height="9"
                      Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                      RenderTransformOrigin="50%,50%"
                      RenderTransform="{Binding SortDescending, Converter={StaticResource SortArrowConverter}}"
                      IsVisible="{Binding SortColumn, Converter={StaticResource EqualsConverter}, ConverterParameter=Size}" />
              </Grid>
            </Button>
          </Grid>
          </Grid>
        </Border>

        <ListBox x:Name="FileList" Grid.Row="1" Classes="files"
                 Classes.densitycompact="{Binding IsDensityCompact}"
                 Classes.densityspacious="{Binding IsDensitySpacious}" ItemsSource="{Binding VisibleItems}"
                 Background="Transparent" SelectionMode="Multiple" DragDrop.AllowDrop="True"
                 SelectionChanged="OnListSelectionChanged"
                 DoubleTapped="OnListDoubleTapped"
                 ContextRequested="OnFileContextRequested"
                 PointerPressed="OnFilePointerPressed"
                 PointerMoved="OnFilePointerMoved"
                 DragDrop.DragEnter="OnFileDragOver" DragDrop.DragOver="OnFileDragOver" DragDrop.DragLeave="OnFileDragLeave" DragDrop.Drop="OnFileDrop"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FileItemViewModel">
              <Panel Classes="fileitem" Classes.dim="{Binding IsHidden}" Classes.gitignored="{Binding IsGitIgnoredDimmed}" ToolTip.Tip="{Binding TooltipText}" Background="Transparent">
                <Border Classes="groupheaderrow" IsVisible="{Binding IsGroupHeader}">
                  <TextBlock Text="{Binding GroupHeaderText}" Classes="groupheadertitle" />
                </Border>
                <Panel IsVisible="{Binding !IsGroupHeader}">
                  <Grid Classes="rowwide" ColumnDefinitions="*,74,116,88,110,86,92"
                        AttachedToVisualTree="OnWideRowAttached">
                    <Grid Grid.Column="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).NameColumnIndex}"
                          ColumnDefinitions="Auto,Auto,*,Auto" Margin="{Binding Indent}">
                      <Button Classes="tool" Width="14" Height="14" Padding="0" Margin="0,0,1,0"
                              IsVisible="{Binding ShowTreeExpander}" Click="OnTreeExpanderClick"
                              ToolTip.Tip="{loc:Tr 展开或收起文件夹}">
                        <Panel Width="9" Height="9">
                          <Path Data="{StaticResource IconChevronRight}" Width="9" Height="9" Stretch="Uniform"
                                Fill="{DynamicResource TextSecondaryBrush}"
                                IsVisible="{Binding !IsTreeExpanded}" />
                          <Path Data="{StaticResource IconChevronDown}" Width="9" Height="9" Stretch="Uniform"
                                Fill="{DynamicResource TextSecondaryBrush}"
                                IsVisible="{Binding IsTreeExpanded}" />
                        </Panel>
                      </Button>
                      <Panel Grid.Column="1" Width="22" Height="22" VerticalAlignment="Center">
                        <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Width="17" Height="17"
                              Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Image Source="{Binding Thumbnail}" Width="20" Height="20" Stretch="UniformToFill"
                               IsVisible="{Binding HasThumbnail}" HorizontalAlignment="Left" />
                        <Path Data="{StaticResource IconLink}" Width="8" Height="8" Stretch="Uniform"
                              Fill="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" IsVisible="{Binding IsSymlink}" />
                        <Border Width="7" Height="7" CornerRadius="4" Background="{Binding TagBrush}"
                                IsVisible="{Binding HasTagColor}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,1,2,0" />
                      </Panel>
                      <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5" Margin="7,0,0,0"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="3" IsVisible="{Binding ShowGitBadge}"
                              Background="{Binding GitBadgeBrush}" CornerRadius="4"
                              Padding="4,1" Margin="5,0,4,0" MinWidth="15" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding GitTooltip}">
                        <TextBlock Text="{Binding GitBadgeText}" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" />
                      </Border>
                    </Grid>
                    <TextBlock Grid.Column="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).SizeColumnIndex}"
                               Text="{Binding SizeText}" Classes="columnvalue"
                               IsVisible="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).ShowSizeColumn}"
                               HorizontalAlignment="Right" Margin="0,0,15,0" />
                    <TextBlock Grid.Column="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).ModifiedColumnIndex}"
                               Text="{Binding ModifiedText}" Classes="columnvalue"
                               IsVisible="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).ShowModifiedColumn}"
                               Margin="0,0,8,0" />
                    <TextBlock Grid.Column="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).TypeColumnIndex}"
                               Text="{Binding TypeText}" Classes="columnvalue"
                               IsVisible="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).ShowTypeColumn}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).TagsColumnIndex}"
                               Text="{Binding TagsColumnText}" Classes="columnvalue"
                               IsVisible="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).ShowTagsColumn}"
                               ToolTip.Tip="{Binding TagTooltip}" Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).PermissionsColumnIndex}"
                               Text="{Binding PermissionText}" Classes="columnvalue"
                               IsVisible="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).ShowPermissionColumn}"
                               FontFamily="{DynamicResource MonoFontFamily}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).OwnerColumnIndex}"
                               Text="{Binding OwnerText}" Classes="columnvalue"
                               IsVisible="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).ShowOwnerColumn}"
                               ToolTip.Tip="{Binding OwnershipText}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Grid Classes="rownarrow" ColumnDefinitions="*,74">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="{Binding Indent}">
                      <Button Classes="tool" Width="14" Height="14" Padding="0" Margin="0,0,1,0"
                              IsVisible="{Binding ShowTreeExpander}" Click="OnTreeExpanderClick"
                              ToolTip.Tip="{loc:Tr 展开或收起文件夹}">
                        <Panel Width="9" Height="9">
                          <Path Data="{StaticResource IconChevronRight}" Width="9" Height="9" Stretch="Uniform"
                                Fill="{DynamicResource TextSecondaryBrush}"
                                IsVisible="{Binding !IsTreeExpanded}" />
                          <Path Data="{StaticResource IconChevronDown}" Width="9" Height="9" Stretch="Uniform"
                                Fill="{DynamicResource TextSecondaryBrush}"
                                IsVisible="{Binding IsTreeExpanded}" />
                        </Panel>
                      </Button>
                      <Panel Grid.Column="1" Width="22" Height="22" VerticalAlignment="Center">
                        <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Width="17" Height="17"
                              Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Image Source="{Binding Thumbnail}" Width="20" Height="20" Stretch="UniformToFill"
                               IsVisible="{Binding HasThumbnail}" HorizontalAlignment="Left" />
                        <Path Data="{StaticResource IconLink}" Width="8" Height="8" Stretch="Uniform"
                              Fill="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" IsVisible="{Binding IsSymlink}" />
                        <Border Width="7" Height="7" CornerRadius="4" Background="{Binding TagBrush}"
                                IsVisible="{Binding HasTagColor}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,1,2,0" />
                      </Panel>
                      <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5" Margin="7,0,0,0"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="3" IsVisible="{Binding ShowGitBadge}"
                              Background="{Binding GitBadgeBrush}" CornerRadius="4"
                              Padding="4,1" Margin="5,0,4,0" MinWidth="15" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding GitTooltip}">
                        <TextBlock Text="{Binding GitBadgeText}" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" />
                      </Border>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="columnvalue"
                               HorizontalAlignment="Right" Margin="0,0,15,0" />
                  </Grid>
                </Panel>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <ListBox x:Name="FileGrid" Classes="tiles" IsVisible="{Binding IsGrid}" ItemsSource="{Binding VisibleItems}"
               Background="Transparent" SelectionMode="Multiple" DragDrop.AllowDrop="True"
               SelectionChanged="OnGridSelectionChanged"
               DoubleTapped="OnListDoubleTapped"
               ContextRequested="OnFileContextRequested"
               PointerPressed="OnFilePointerPressed"
               PointerMoved="OnFilePointerMoved"
               DragDrop.DragEnter="OnFileDragOver" DragDrop.DragOver="OnFileDragOver" DragDrop.DragLeave="OnFileDragLeave" DragDrop.Drop="OnFileDrop"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <views:VirtualizingWrapPanel ItemWidth="118" ItemHeight="108" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FileItemViewModel">
            <StackPanel Classes="filetile" Classes.dim="{Binding IsHidden}" Classes.gitignored="{Binding IsGitIgnoredDimmed}"
                        Width="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).TileWidth}"
                        Spacing="3" ToolTip.Tip="{Binding TooltipText}">
              <Panel Height="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).TileImageHeight}"
                     HorizontalAlignment="Center">
                <Path Data="{Binding Icon}" Fill="{Binding IconBrush}"
                      Width="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).TileIconSize}"
                      Height="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).TileIconSize}"
                      Stretch="Uniform" IsVisible="{Binding !HasThumbnail}" />
                <Image Source="{Binding Thumbnail}"
                       Height="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).TileImageHeight}"
                       Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                <Border IsVisible="{Binding ShowGitBadge}" Background="{Binding GitBadgeBrush}"
                        CornerRadius="4" Padding="4,1" MinWidth="15"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip.Tip="{Binding GitTooltip}">
                  <TextBlock Text="{Binding GitBadgeText}" FontSize="8.5" FontWeight="SemiBold"
                             Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <Border Width="9" Height="9" CornerRadius="5" Background="{Binding TagBrush}"
                        IsVisible="{Binding HasTagColor}" HorizontalAlignment="Left"
                        VerticalAlignment="Bottom" Margin="2,0,0,2" />
              </Panel>
              <TextBlock Text="{Binding Name}" TextAlignment="Center"
                         FontSize="{Binding $parent[UserControl].((vm:PaneViewModel)DataContext).TileFontSize}"
                         TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding GridSubtitle}" Classes="tiny" TextAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid IsVisible="{Binding ShowMiller}" Background="{DynamicResource SurfaceBrush}">
        <ScrollViewer x:Name="MillerScroller" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding MillerColumns}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MillerColumnViewModel">
                <Border Width="270" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                        Background="{DynamicResource SurfaceBrush}">
                  <Grid RowDefinitions="Auto,*">
                    <Border Padding="11,5" Background="{DynamicResource SurfaceAltBrush}">
                      <TextBlock Text="{Binding Header}" FontSize="11.5" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             SelectionChanged="OnMillerSelectionChanged"
                             PointerPressed="OnMillerPointerPressed"
                             DoubleTapped="OnMillerDoubleTapped"
                             KeyDown="OnMillerKeyDown"
                             ContextRequested="OnMillerContextRequested"
                             Background="Transparent" SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" Margin="2,0">
                            <Panel Width="20" Height="20" VerticalAlignment="Center">
                              <Path Data="{Binding Icon}" Fill="{Binding IconBrush}" Width="15" Height="15"
                                    Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                              <Border Width="6" Height="6" CornerRadius="3" Background="{Binding TagBrush}"
                                      IsVisible="{Binding HasTagColor}" HorizontalAlignment="Right"
                                      VerticalAlignment="Top" />
                            </Panel>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2" IsVisible="{Binding ShowGitBadge}"
                                    Background="{Binding GitBadgeBrush}" CornerRadius="3"
                                    Padding="3,1" MinWidth="13" VerticalAlignment="Center">
                              <TextBlock Text="{Binding GitBadgeText}" FontSize="8" FontWeight="SemiBold"
                                         Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Rubber-band selection -->
      <Canvas x:Name="MarqueeLayer" Grid.Row="1" IsHitTestVisible="False"
              IsVisible="False" ClipToBounds="True">
        <Border x:Name="MarqueeRect" Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="2" />
      </Canvas>

      <!-- Loading -->
      <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.88" IsVisible="{Binding IsLoading}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
          <ProgressBar IsIndeterminate="True" Width="120" Height="3" />
          <TextBlock Text="{loc:Tr 正在读取…}" Classes="caption" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Error -->
      <Border Background="{DynamicResource SurfaceBrush}" IsVisible="{Binding HasError}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="340">
          <Path Data="{StaticResource IconWarning}" Width="30" Height="30" Stretch="Uniform"
                Fill="{DynamicResource WarningBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ErrorMessage}" TextAlignment="Center" TextWrapping="Wrap" />
          <Button Classes="subtle" Content="{loc:Tr 重试}" HorizontalAlignment="Center"
                  Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Border>

      <!-- Empty -->
      <Border Background="Transparent" IsVisible="{Binding IsEmpty}" IsHitTestVisible="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
          <Path Data="{StaticResource IconFolderOpen}" Width="42" Height="42" Stretch="Uniform"
                Fill="{DynamicResource BorderStrongBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyHint}" Classes="muted" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Tr 将文件拖到这里即可移动或复制}" Classes="tiny" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Drop target -->
      <Border IsVisible="{Binding IsDropTarget}" IsHitTestVisible="False"
              Background="{DynamicResource DropOverlayBrush}"
              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="4"
              Margin="4">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
          <Path Data="{StaticResource IconDownload}" Width="28" Height="28" Stretch="Uniform"
                Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding DropHint}" HorizontalAlignment="Center" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DropDestination}" HorizontalAlignment="Center" Classes="caption"
                     TextTrimming="CharacterEllipsis" MaxWidth="360"
                     IsVisible="{Binding DropDestination, Converter={StaticResource NotNullConverter}}" />
          <TextBlock Text="{loc:Tr Ctrl 复制 · Shift 移动}" HorizontalAlignment="Center" Classes="tiny"
                     IsVisible="{Binding DropShowsModifiers}" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Status bar -->
    <Border Grid.Row="3" Height="26" Background="{DynamicResource StatusBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding ItemCountText}" Classes="tiny" />
          <TextBlock Text="{Binding SelectionText}" Classes="tiny"
                     IsVisible="{Binding HasSelection}" />
          <TextBlock Text="{Binding GitStatusText}" Classes="tiny"
                     Foreground="{Binding GitStatusBrush}"
                     ToolTip.Tip="{Binding GitTooltipText}"
                     IsVisible="{Binding ShowGitStatusBar}" />
          <TextBlock Text="{Binding FsBadgeText}" Classes="tiny" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding RemoteLatencyText}" Classes="tiny"
                     Foreground="{Binding RemoteLatencyBrush}" IsVisible="{Binding IsRemote}"
                     ToolTip.Tip="{loc:Tr 最近一次列目录耗时}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding FreeSpaceText}" Classes="tiny" />
          <TextBlock Text="{Binding SortColumnLabel}" Classes="tiny" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
