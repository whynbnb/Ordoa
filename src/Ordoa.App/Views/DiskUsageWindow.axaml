<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:Ordoa.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ordoa.App.ViewModels.Dialogs"
        xmlns:views="using:Ordoa.App.Views"
        x:DataType="vm:DiskUsageDialogViewModel"
        x:CompileBindings="True"
        x:Class="Ordoa.App.Views.DiskUsageWindow"
        Title="{loc:Tr 磁盘占用分析}"
        Width="1160" Height="760" MinWidth="820" MinHeight="540" CanResize="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="22,15,22,12" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Tr 磁盘占用分析}" Classes="h2" />
          <TextBlock Text="{Binding CurrentPath}" Classes="caption"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                    VerticalAlignment="Center">
          <Button Content="{loc:Tr 上一级}" Classes="subtle" Click="OnUpClick"
                  IsEnabled="{Binding CanGoUp}" />
          <Button Content="{loc:Tr 重新扫描}" Classes="subtle" Click="OnRescanClick"
                  IsEnabled="{Binding !IsScanning}" />
          <Button Content="{loc:Tr 停止}" Classes="subtle" Click="OnStopClick"
                  IsVisible="{Binding IsScanning}" />
          <Button Content="{loc:Tr 关闭}" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,320" ColumnSpacing="14" Margin="18,14,18,10">
      <Border Grid.Column="0" Classes="card" Padding="4" ClipToBounds="True">
        <Grid>
          <views:TreemapView Items="{Binding TreemapEntries}"
                             EntryActivated="OnEntryActivated" Margin="4" />
          <TextBlock Text="{Binding StatusText}" Classes="caption"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"
                     IsVisible="{Binding IsEmpty}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="12,10">
        <Grid RowDefinitions="Auto,3*,Auto,2*" RowSpacing="4">
          <TextBlock Text="{loc:Tr 当前目录}" Classes="section" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   DoubleTapped="OnItemDoubleTapped"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiskUsageItem">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,4">
                  <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Brush}"
                          VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PercentText}" Classes="tiny" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="tiny"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="2" Text="{loc:Tr 最大文件}" Classes="section" Margin="0,7,0,3" />
          <ListBox Grid.Row="3" ItemsSource="{Binding LargestFiles}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiskUsageFileItem">
                <StackPanel Spacing="1" Margin="0,3">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="tiny" />
                  </Grid>
                  <TextBlock Text="{Binding Folder}" Classes="tiny"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="18,10,18,14" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding ScanSummary}" Classes="caption" TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                       IsVisible="{Binding IsScanning}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Tr 打开}" Classes="subtle" Click="OnOpenSelectedClick"
                  IsEnabled="{Binding CanOpenSelected}" />
          <Button Content="{loc:Tr 关闭}" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
