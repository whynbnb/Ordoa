<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ordoa.App.Views.SettingsWindow"
        Title="设置"
        Width="660" Height="650" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.chip.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.chip.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.accentdot">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.accentdot.active">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.fieldlabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.fieldhint">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="22,16,22,12" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="2">
        <TextBlock Text="设置" Classes="h2" />
        <TextBlock Text="外观、浏览行为与高级选项" Classes="caption" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="22,14,22,8" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <!-- Appearance -->
        <TextBlock Text="外观" Classes="section" />
        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="主题" Classes="fieldlabel" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="chip" Tag="System" Click="OnThemeClick"
                    Classes.active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=System}">
              <TextBlock Text="跟随系统" />
            </Button>
            <Button Classes="chip" Tag="Light" Click="OnThemeClick"
                    Classes.active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=Light}">
              <TextBlock Text="浅色" />
            </Button>
            <Button Classes="chip" Tag="Dark" Click="OnThemeClick"
                    Classes.active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=Dark}">
              <TextBlock Text="深色" />
            </Button>
          </StackPanel>

          <TextBlock Grid.Row="1" Text="强调色" Classes="fieldlabel" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="9">
            <Border Background="#17937F" Tag="Jade" PointerPressed="OnAccentClick" ToolTip.Tip="翡翠"
                    Classes="accentdot"
                    Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Jade}" />
            <Border Background="#3B7EDB" Tag="Blue" PointerPressed="OnAccentClick" ToolTip.Tip="靛蓝"
                    Classes="accentdot"
                    Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Blue}" />
            <Border Background="#C9862B" Tag="Amber" PointerPressed="OnAccentClick" ToolTip.Tip="琥珀"
                    Classes="accentdot"
                    Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Amber}" />
            <Border Background="#C2688A" Tag="Rose" PointerPressed="OnAccentClick" ToolTip.Tip="玫瑰"
                    Classes="accentdot"
                    Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Rose}" />
            <Border Background="#7C63D8" Tag="Violet" PointerPressed="OnAccentClick" ToolTip.Tip="紫罗兰"
                    Classes="accentdot"
                    Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Violet}" />
          </StackPanel>

          <TextBlock Grid.Row="2" Text="密度" Classes="fieldlabel" />
          <CheckBox Grid.Row="2" Grid.Column="1" Content="紧凑模式（更小的行高与间距）"
                    IsChecked="{Binding CompactMode, Mode=TwoWay}" />

          <TextBlock Grid.Row="3" Text="默认视图" Classes="fieldlabel" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="chip" Tag="List" Click="OnViewClick"
                    Classes.active="{Binding View, Converter={StaticResource EqualsConverter}, ConverterParameter=List}">
              <TextBlock Text="列表" />
            </Button>
            <Button Classes="chip" Tag="Grid" Click="OnViewClick"
                    Classes.active="{Binding View, Converter={StaticResource EqualsConverter}, ConverterParameter=Grid}">
              <TextBlock Text="网格" />
            </Button>
          </StackPanel>
        </Grid>

        <Border Classes="divider" />

        <!-- Browsing -->
        <TextBlock Text="浏览" Classes="section" />
        <StackPanel Spacing="7">
          <CheckBox Content="显示隐藏文件（点文件）" IsChecked="{Binding ShowHidden, Mode=TwoWay}" />
          <CheckBox Content="文件夹排在文件之前" IsChecked="{Binding FoldersFirst, Mode=TwoWay}" />
          <CheckBox Content="在网格视图中加载图片缩略图" IsChecked="{Binding ShowThumbnails, Mode=TwoWay}" />
          <CheckBox Content="显示左侧栏" IsChecked="{Binding ShowSidebar, Mode=TwoWay}" />
          <CheckBox Content="操作开始时自动展开传输队列" IsChecked="{Binding ShowTransferPanel, Mode=TwoWay}" />
        </StackPanel>

        <Border Classes="divider" />

        <!-- Behaviour -->
        <TextBlock Text="行为与安全" Classes="section" />
        <StackPanel Spacing="7">
          <CheckBox Content="永久删除前请求确认" IsChecked="{Binding ConfirmPermanentDelete, Mode=TwoWay}" />
          <CheckBox Content="启动时恢复上次的标签页与分屏" IsChecked="{Binding RestoreSession, Mode=TwoWay}" />
        </StackPanel>

        <Border Classes="divider" />

        <!-- Search -->
        <TextBlock Text="搜索" Classes="section" />
        <Grid ColumnDefinitions="120,140,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBlock Text="最大深度" Classes="fieldlabel" />
          <NumericUpDown Grid.Column="1" Minimum="1" Maximum="64" Increment="1" FormatString="0"
                         Value="{Binding SearchDepth, Mode=TwoWay}" />
          <TextBlock Grid.Column="2" Text="目录层级越深，搜索用时越长" Classes="fieldhint"
                     VerticalAlignment="Center" Margin="10,0,0,0" />

          <TextBlock Grid.Row="1" Text="最大结果" Classes="fieldlabel" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="100" Maximum="20000" Increment="100"
                         FormatString="0" Value="{Binding MaxSearchResults, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="达到上限后停止继续扫描" Classes="fieldhint"
                     VerticalAlignment="Center" Margin="10,0,0,0" />
        </Grid>

        <Border Classes="divider" />

        <StackPanel Spacing="4">
          <TextBlock Text="设置保存在" Classes="section" />
          <TextBlock Text="{Binding SettingsPath}" Classes="tiny" FontFamily="{DynamicResource MonoFontFamily}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="18,10,18,14" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Content="恢复默认值" Classes="ghost" Click="OnResetClick" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="取消" Click="OnCancelClick" />
          <Button Content="保存" Classes="accent" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
