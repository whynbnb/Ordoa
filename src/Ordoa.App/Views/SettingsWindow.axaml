<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Ordoa.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ordoa.App.ViewModels.Dialogs"
        xmlns:views="using:Ordoa.App.Views"
        x:DataType="vm:SettingsDialogViewModel"
        x:CompileBindings="True"
        x:Class="Ordoa.App.Views.SettingsWindow"
        Title="{loc:Tr 设置}"
        Width="920" Height="700" MinWidth="780" MinHeight="540" CanResize="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.chip.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.chip.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.accentdot">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.accentdot.active">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.fieldlabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.fieldhint">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="views|HintBlock.inlineHint">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="views|HintBlock.inlineHint.collapsed">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="ListBox.settingsnav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,10" />
    </Style>
    <Style Selector="ListBox.settingsnav ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="ListBox.settingsnav ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ListBox.settingsnav ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ListBox.settingsnav ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.settingsnav Path">
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox.settingsnav ListBoxItem:selected Path">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="24,16,24,12" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="2">
        <TextBlock Text="{loc:Tr 设置}" Classes="h2" />
        <TextBlock Text="{loc:Tr 按类别调整外观、浏览、终端、命令、网络与系统行为}" Classes="caption" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="190,*">
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <ListBox Classes="settingsnav" ItemsSource="{Binding Categories}"
                 SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                 SelectionMode="Single" SelectionChanged="OnCategoryChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,5">
                <Path Data="{Binding Icon}" Width="15" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" Padding="24,18,24,14"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">

          <!-- Appearance -->
          <StackPanel IsVisible="{Binding ShowAppearance}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 外观}" Classes="h2" />
              <TextBlock Text="{loc:Tr 主题、强调色、密度与窗口外观}" Classes="caption" />
            </StackPanel>

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Text="{loc:Tr 主题}" Classes="fieldlabel" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Tag="System" Click="OnThemeClick"
                        Classes.active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=System}">
                  <TextBlock Text="{loc:Tr 跟随系统}" />
                </Button>
                <Button Classes="chip" Tag="Light" Click="OnThemeClick"
                        Classes.active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=Light}">
                  <TextBlock Text="{loc:Tr 浅色}" />
                </Button>
                <Button Classes="chip" Tag="Dark" Click="OnThemeClick"
                        Classes.active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=Dark}">
                  <TextBlock Text="{loc:Tr 深色}" />
                </Button>
              </StackPanel>

              <TextBlock Grid.Row="1" Text="{loc:Tr 强调色}" Classes="fieldlabel" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="9">
                <Border Background="#17937F" Tag="Jade" PointerPressed="OnAccentClick" ToolTip.Tip="{loc:Tr 翡翠}"
                        Classes="accentdot"
                        Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Jade}" />
                <Border Background="#3B7EDB" Tag="Blue" PointerPressed="OnAccentClick" ToolTip.Tip="{loc:Tr 靛蓝}"
                        Classes="accentdot"
                        Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Blue}" />
                <Border Background="#C9862B" Tag="Amber" PointerPressed="OnAccentClick" ToolTip.Tip="{loc:Tr 琥珀}"
                        Classes="accentdot"
                        Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Amber}" />
                <Border Background="#C2688A" Tag="Rose" PointerPressed="OnAccentClick" ToolTip.Tip="{loc:Tr 玫瑰}"
                        Classes="accentdot"
                        Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Rose}" />
                <Border Background="#7C63D8" Tag="Violet" PointerPressed="OnAccentClick" ToolTip.Tip="{loc:Tr 紫罗兰}"
                        Classes="accentdot"
                        Classes.active="{Binding Accent, Converter={StaticResource EqualsConverter}, ConverterParameter=Violet}" />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="{loc:Tr 密度}" Classes="fieldlabel" />
              <CheckBox Grid.Row="2" Grid.Column="1" Content="{loc:Tr 紧凑模式（更小的行高与间距）}"
                        IsChecked="{Binding CompactMode, Mode=TwoWay}" />

              <TextBlock Grid.Row="3" Text="{loc:Tr 默认视图}" Classes="fieldlabel" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Tag="List" Click="OnViewClick"
                        Classes.active="{Binding View, Converter={StaticResource EqualsConverter}, ConverterParameter=List}">
                  <TextBlock Text="{loc:Tr 列表}" />
                </Button>
                <Button Classes="chip" Tag="Grid" Click="OnViewClick"
                        Classes.active="{Binding View, Converter={StaticResource EqualsConverter}, ConverterParameter=Grid}">
                  <TextBlock Text="{loc:Tr 网格}" />
                </Button>
              </StackPanel>

              <TextBlock Grid.Row="4" Text="{loc:Tr 窗口}" Classes="fieldlabel" />
              <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <CheckBox Content="{loc:Tr 使用系统标题栏（非沉浸式）}"
                          IsChecked="{Binding UseSystemWindowFrame, Mode=TwoWay}" />
                <views:HintBlock Classes="inlineHint" Classes.collapsed="{Binding CollapseHints}"
                                 Text="{loc:Tr 关闭时使用沉浸式自绘标题栏；打开时保留系统非客户区。}"
                                 IsCollapsed="{Binding CollapseHints}" />
              </Grid>

              <TextBlock Grid.Row="5" Text="{loc:Tr 窗口按钮}" Classes="fieldlabel" />
              <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="chip" Tag="Auto" Click="OnWindowButtonModeClick"
                          Classes.active="{Binding WindowButtonMode, Converter={StaticResource EqualsConverter}, ConverterParameter=Auto}">
                    <TextBlock Text="{loc:Tr 自动}" />
                  </Button>
                  <Button Classes="chip" Tag="Show" Click="OnWindowButtonModeClick"
                          Classes.active="{Binding WindowButtonMode, Converter={StaticResource EqualsConverter}, ConverterParameter=Show}">
                    <TextBlock Text="{loc:Tr 显示}" />
                  </Button>
                  <Button Classes="chip" Tag="Hide" Click="OnWindowButtonModeClick"
                          Classes.active="{Binding WindowButtonMode, Converter={StaticResource EqualsConverter}, ConverterParameter=Hide}">
                    <TextBlock Text="{loc:Tr 隐藏}" />
                  </Button>
                </StackPanel>
                <views:HintBlock Classes="inlineHint" Classes.collapsed="{Binding CollapseHints}"
                                 Text="{loc:Tr 自动会在 niri、Sway、Hyprland 等平铺合成器下隐藏窗口按钮。}"
                                 IsVisible="{Binding IsLinux}"
                                 IsCollapsed="{Binding CollapseHints}" />
              </Grid>

              <TextBlock Grid.Row="6" Text="{loc:Tr 语言}" Classes="fieldlabel" />
              <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Tag="System" Click="OnLanguageClick"
                        Classes.active="{Binding Language, Converter={StaticResource EqualsConverter}, ConverterParameter=System}">
                  <TextBlock Text="{loc:Tr 跟随系统}" />
                </Button>
                <Button Classes="chip" Tag="Chinese" Click="OnLanguageClick"
                        Classes.active="{Binding Language, Converter={StaticResource EqualsConverter}, ConverterParameter=Chinese}">
                  <TextBlock Text="中文" />
                </Button>
                <Button Classes="chip" Tag="English" Click="OnLanguageClick"
                        Classes.active="{Binding Language, Converter={StaticResource EqualsConverter}, ConverterParameter=English}">
                  <TextBlock Text="English" />
                </Button>
              </StackPanel>

              <TextBlock Grid.Row="7" Text="{loc:Tr 说明}" Classes="fieldlabel" />
              <CheckBox Grid.Row="7" Grid.Column="1"
                        Content="{loc:Tr 折叠说明文字（悬停查看）}"
                        IsChecked="{Binding CollapseHints, Mode=TwoWay}" />
            </Grid>
          </StackPanel>

          <!-- Browsing -->
          <StackPanel IsVisible="{Binding ShowBrowsing}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 浏览}" Classes="h2" />
              <TextBlock Text="{loc:Tr 文件列表、缩略图、搜索与传输队列}" Classes="caption" />
            </StackPanel>

            <TextBlock Text="{loc:Tr 文件列表}" Classes="section" />
            <StackPanel Spacing="7">
              <CheckBox Content="{loc:Tr 显示隐藏文件（点文件）}" IsChecked="{Binding ShowHidden, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 文件夹排在文件之前}" IsChecked="{Binding FoldersFirst, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 在网格视图中加载图片缩略图}" IsChecked="{Binding ShowThumbnails, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 耗时操作时自动展开传输队列}" IsChecked="{Binding ShowTransferPanel, Mode=TwoWay}" />
              <Grid IsVisible="{Binding IsMacOS}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <CheckBox Content="{loc:Tr 将 .app 识别为应用程序}"
                          IsChecked="{Binding MacAppBundles, Mode=TwoWay}" />
                <views:HintBlock Classes="inlineHint" Classes.collapsed="{Binding CollapseHints}"
                                 Text="{loc:Tr macOS 上把 .app 文件夹显示为应用程序，双击直接启动；右键可显示包内容。}"
                                 IsCollapsed="{Binding CollapseHints}" />
              </Grid>
            </StackPanel>

            <TextBlock Text="{loc:Tr 列表列}" Classes="section" />
            <StackPanel Spacing="7">
              <CheckBox Content="{loc:Tr 显示大小列}" IsChecked="{Binding ShowSizeColumn, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 显示修改时间列}" IsChecked="{Binding ShowModifiedColumn, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 显示类型列}" IsChecked="{Binding ShowTypeColumn, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 显示权限列}" IsChecked="{Binding ShowPermissionColumn, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 显示所有者列}" IsChecked="{Binding ShowOwnerColumn, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 显示标签 / 颜色列}" IsChecked="{Binding ShowTagsColumn, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock Text="{loc:Tr 网格与行密度}" Classes="section" />
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="{loc:Tr 网格缩略图}" Classes="fieldlabel" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Tag="Small" Click="OnGridSizeClick"
                        Classes.active="{Binding GridThumbnailSize, Converter={StaticResource EqualsConverter}, ConverterParameter=Small}">
                  <TextBlock Text="{loc:Tr 小}" />
                </Button>
                <Button Classes="chip" Tag="Medium" Click="OnGridSizeClick"
                        Classes.active="{Binding GridThumbnailSize, Converter={StaticResource EqualsConverter}, ConverterParameter=Medium}">
                  <TextBlock Text="{loc:Tr 中}" />
                </Button>
                <Button Classes="chip" Tag="Large" Click="OnGridSizeClick"
                        Classes.active="{Binding GridThumbnailSize, Converter={StaticResource EqualsConverter}, ConverterParameter=Large}">
                  <TextBlock Text="{loc:Tr 大}" />
                </Button>
              </StackPanel>

              <TextBlock Grid.Row="1" Text="{loc:Tr 列表行高}" Classes="fieldlabel" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Tag="Compact" Click="OnDensityClick"
                        Classes.active="{Binding ListDensity, Converter={StaticResource EqualsConverter}, ConverterParameter=Compact}">
                  <TextBlock Text="{loc:Tr 紧凑}" />
                </Button>
                <Button Classes="chip" Tag="Normal" Click="OnDensityClick"
                        Classes.active="{Binding ListDensity, Converter={StaticResource EqualsConverter}, ConverterParameter=Normal}">
                  <TextBlock Text="{loc:Tr 标准}" />
                </Button>
                <Button Classes="chip" Tag="Spacious" Click="OnDensityClick"
                        Classes.active="{Binding ListDensity, Converter={StaticResource EqualsConverter}, ConverterParameter=Spacious}">
                  <TextBlock Text="{loc:Tr 宽松}" />
                </Button>
              </StackPanel>

              <TextBlock Grid.Row="2" Text="{loc:Tr 列表分组}" Classes="fieldlabel" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Tag="None" Click="OnGroupClick"
                        Classes.active="{Binding GroupBy, Converter={StaticResource EqualsConverter}, ConverterParameter=None}">
                  <TextBlock Text="{loc:Tr 不分组}" />
                </Button>
                <Button Classes="chip" Tag="Type" Click="OnGroupClick"
                        Classes.active="{Binding GroupBy, Converter={StaticResource EqualsConverter}, ConverterParameter=Type}">
                  <TextBlock Text="{loc:Tr 类型}" />
                </Button>
                <Button Classes="chip" Tag="Modified" Click="OnGroupClick"
                        Classes.active="{Binding GroupBy, Converter={StaticResource EqualsConverter}, ConverterParameter=Modified}">
                  <TextBlock Text="{loc:Tr 修改时间}" />
                </Button>
                <Button Classes="chip" Tag="Size" Click="OnGroupClick"
                        Classes.active="{Binding GroupBy, Converter={StaticResource EqualsConverter}, ConverterParameter=Size}">
                  <TextBlock Text="{loc:Tr 大小}" />
                </Button>
              </StackPanel>
            </Grid>

            <Border Classes="divider" />

            <TextBlock Text="{loc:Tr 搜索}" Classes="section" />
            <Grid ColumnDefinitions="120,140,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Text="{loc:Tr 最大深度}" Classes="fieldlabel" />
              <NumericUpDown Grid.Column="1" Minimum="1" Maximum="64" Increment="1" FormatString="0"
                             Value="{Binding SearchDepth, Mode=TwoWay}" />
              <views:HintBlock Grid.Column="2" Text="{loc:Tr 目录层级越深，搜索用时越长}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               IsCollapsed="{Binding CollapseHints}" />

              <TextBlock Grid.Row="1" Text="{loc:Tr 最大结果}" Classes="fieldlabel" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="100" Maximum="20000" Increment="100"
                             FormatString="0" Value="{Binding MaxSearchResults, Mode=TwoWay}" />
              <views:HintBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr 达到上限后停止继续扫描}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               IsCollapsed="{Binding CollapseHints}" />
            </Grid>

            <Border Classes="divider" />

            <TextBlock Text="{loc:Tr 搜索索引}" Classes="section" />
            <CheckBox Content="{loc:Tr 启用本地搜索索引（默认关闭）}"
                      IsChecked="{Binding SearchIndexEnabled, Mode=TwoWay}" />
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="{loc:Tr 范围模式}" Classes="fieldlabel" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Tag="Whitelist" Click="OnSearchIndexModeClick"
                        Classes.active="{Binding SearchIndexMode, Converter={StaticResource EqualsConverter}, ConverterParameter=Whitelist}">
                  <TextBlock Text="{loc:Tr 白名单}" />
                </Button>
                <Button Classes="chip" Tag="Blacklist" Click="OnSearchIndexModeClick"
                        Classes.active="{Binding SearchIndexMode, Converter={StaticResource EqualsConverter}, ConverterParameter=Blacklist}">
                  <TextBlock Text="{loc:Tr 黑名单}" />
                </Button>
              </StackPanel>

              <TextBlock Grid.Row="1" Text="{loc:Tr 索引目录}" Classes="fieldlabel" />
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5">
                <TextBox Text="{Binding SearchIndexRootsText, Mode=TwoWay}" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="64" />
                <Button Grid.Column="1" Content="{loc:Tr 添加文件夹…}" Classes="subtle"
                        Margin="6,0,0,0" Click="OnAddIndexRootClick" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{loc:Tr 每行一个目录。白名单模式只索引这些目录；黑名单模式在此基础上排除下方规则。}"
                           Classes="fieldhint" TextWrapping="Wrap" />
              </Grid>

              <TextBlock Grid.Row="2" Text="{loc:Tr 排除规则}" Classes="fieldlabel" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SearchIndexExcludesText, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" Height="52" />

              <TextBlock Grid.Row="3" Grid.Column="1"
                         Text="{loc:Tr 每行一个路径前缀或 glob，例如 node_modules 或 *.tmp。}"
                         Classes="fieldhint" TextWrapping="Wrap" />

              <TextBlock Grid.Row="4" Text="{loc:Tr 索引状态}" Classes="fieldlabel" />
              <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding SearchIndexStatus}" Classes="caption" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="{loc:Tr 重建索引}" Classes="subtle"
                        Click="OnRebuildIndexClick" IsEnabled="{Binding !IsRebuildingIndex}" />
              </Grid>
            </Grid>

            <Border Classes="divider" />

            <TextBlock Text="{loc:Tr 传输}" Classes="section" />
            <CheckBox Content="{loc:Tr 批量复制/移动前显示目标位置与冲突预览}"
                      IsChecked="{Binding ShowTransferPreview, Mode=TwoWay}" />
            <CheckBox Content="{loc:Tr 远程文件在外部修改后自动回传}"
                      IsChecked="{Binding UploadRemoteEdits, Mode=TwoWay}" />
            <Grid ColumnDefinitions="120,140,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="{loc:Tr 并发任务}" Classes="fieldlabel" />
              <NumericUpDown Grid.Column="1" Minimum="1" Maximum="4" Increment="1" FormatString="0"
                             Value="{Binding TransferConcurrency, Mode=TwoWay}" />
              <views:HintBlock Grid.Column="2" Text="{loc:Tr 同时执行的传输任务数量}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               IsCollapsed="{Binding CollapseHints}" />

              <TextBlock Grid.Row="1" Text="{loc:Tr 速度限制}" Classes="fieldlabel" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100000" Increment="1"
                             FormatString="0" Value="{Binding TransferSpeedLimit, Mode=TwoWay}" />
              <views:HintBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr 单位 MB/s；0 表示不限制}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               IsCollapsed="{Binding CollapseHints}" />

              <TextBlock Grid.Row="2" Text="{loc:Tr 复制校验}" Classes="fieldlabel" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CopyVerificationModes}"
                        SelectedIndex="{Binding CopyVerificationIndex, Mode=TwoWay}"
                        MinWidth="140" HorizontalAlignment="Left" />
              <views:HintBlock Grid.Row="2" Grid.Column="2" Text="{loc:Tr 校验失败的文件会标记为失败，可单独重试}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               IsCollapsed="{Binding CollapseHints}" />
            </Grid>

            <Border Classes="divider" />

            <TextBlock Text="{loc:Tr 压缩}" Classes="section" />
            <Grid ColumnDefinitions="120,140,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="{loc:Tr 7z 压缩级别}" Classes="fieldlabel" />
              <NumericUpDown Grid.Column="1" Minimum="0" Maximum="9" Increment="1" FormatString="0"
                             Value="{Binding ArchiveCompressionLevel, Mode=TwoWay}" />
              <views:HintBlock Grid.Column="2" Text="{loc:Tr 0 最快，9 最小；默认 5}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               IsCollapsed="{Binding CollapseHints}" />

              <TextBlock Grid.Row="1" Text="{loc:Tr 分卷大小}" Classes="fieldlabel" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100000" Increment="10"
                             FormatString="0" Value="{Binding ArchiveSplitMb, Mode=TwoWay}" />
              <views:HintBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr 单位 MB；0 表示不分卷}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               IsCollapsed="{Binding CollapseHints}" />

              <TextBlock Grid.Row="2" Text="{loc:Tr 旧 ZIP 文件名编码}" Classes="fieldlabel" />
              <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                        ItemsSource="{Binding ArchiveEncodingModes}"
                        SelectedIndex="{Binding ArchiveEncodingIndex, Mode=TwoWay}"
                        HorizontalAlignment="Left" MinWidth="190" />
            </Grid>
            <TextBlock Text="{loc:Tr 自动检测会尝试 UTF-8、GBK、Shift-JIS 和 CP437；解压包含中文或日文文件名的旧 ZIP 时可手动指定。}"
                       Classes="fieldhint" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Sidebar -->
          <StackPanel IsVisible="{Binding ShowSidebarCategory}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 侧栏}" Classes="h2" />
              <TextBlock Text="{loc:Tr 侧栏显示内容、位置与自定义路径}" Classes="caption" />
            </StackPanel>

            <TextBlock Text="{loc:Tr 显示内容}" Classes="section" />
            <StackPanel Spacing="7">
              <CheckBox Content="{loc:Tr 显示左侧栏}" IsChecked="{Binding ShowSidebar, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 显示磁盘}" IsChecked="{Binding ShowVolumes, Mode=TwoWay}" />
              <Grid IsVisible="{Binding IsMacOS}" ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto">
                <CheckBox Content="{loc:Tr 显示 macOS 系统隐藏卷}"
                          IsChecked="{Binding ShowHiddenVolumes, Mode=TwoWay}" />
                <views:HintBlock Classes="inlineHint" Classes.collapsed="{Binding CollapseHints}"
                                 Text="{loc:Tr 默认只显示 / 和 /Volumes 下的磁盘；打开后会显示 /System/Volumes 等内部卷。}"
                                 IsCollapsed="{Binding CollapseHints}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding HasVolumes}">
              <TextBlock Text="{loc:Tr 显示的磁盘}" Classes="section" />
              <ItemsControl ItemsSource="{Binding Volumes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VolumeVisibilityViewModel">
                    <CheckBox Width="220" Margin="0,2,8,2" Content="{Binding Label}"
                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                              ToolTip.Tip="{Binding Detail}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Classes="divider" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr 侧栏位置}" Classes="section" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="{loc:Tr 恢复默认位置}" Classes="ghost" FontSize="11"
                      Padding="8,3" Click="OnResetPlacesClick" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Places}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaceVisibilityViewModel">
                  <CheckBox Width="180" Margin="0,2,8,2" Content="{Binding Label}"
                            IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{loc:Tr 自定义位置}" Classes="section" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding NewCustomPath, Mode=TwoWay}"
                       PlaceholderText="{loc:Tr 添加路径，例如 ~/Projects 或 /mnt/data}" />
              <Button Grid.Column="1" Content="{loc:Tr 添加}" Classes="chip" Click="OnAddCustomPathClick" />
            </Grid>
            <TextBlock Text="{Binding CustomPathError}" Classes="fieldhint" Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding CustomPathError, Converter={StaticResource NotNullConverter}}" />
            <ItemsControl ItemsSource="{Binding CustomPaths}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CustomPathViewModel">
                  <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="10,6"
                          Margin="0,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                        <TextBlock Text="{Binding Detail}" Classes="tiny" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="tool" Width="24" Height="24"
                              Tag="{Binding Path}" Click="OnRemoveCustomPathClick"
                              ToolTip.Tip="{loc:Tr 移除}">
                        <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stretch="Uniform"
                              Fill="{DynamicResource TextTertiaryBrush}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Preview -->
          <StackPanel IsVisible="{Binding ShowPreview}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 预览}" Classes="h2" />
              <TextBlock Text="{loc:Tr 快速预览与常驻预览面板}" Classes="caption" />
            </StackPanel>

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto" RowSpacing="6">
              <TextBlock Text="{loc:Tr ffmpeg 路径}" Classes="fieldlabel" VerticalAlignment="Center" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBox Text="{Binding FfmpegPath, Mode=TwoWay}"
                         PlaceholderText="{loc:Tr 留空则自动从 PATH / FFMPEG_PATH 查找}" />
                <views:HintBlock Classes="inlineHint" Classes.collapsed="{Binding CollapseHints}"
                                 Text="{loc:Tr 用于视频缩略图与音视频信息；Ordoa 不附带 ffmpeg。图片预览不依赖它。}"
                                 IsCollapsed="{Binding CollapseHints}" />
              </Grid>
            </Grid>

            <Border Classes="divider" />

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Text="{loc:Tr 常驻预览面板}" Classes="fieldlabel" VerticalAlignment="Top" Margin="0,2,0,0" />
              <Grid Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <CheckBox Content="{loc:Tr 显示常驻预览面板}"
                          IsChecked="{Binding ShowPreviewPanel, Mode=TwoWay}" />
                <views:HintBlock Classes="inlineHint" Classes.collapsed="{Binding CollapseHints}"
                                 Text="{loc:Tr 默认关闭；也可按 F3 或点击工具栏图标随时切换。}"
                                 IsCollapsed="{Binding CollapseHints}" />
              </Grid>
              <TextBlock Grid.Row="1" Text="{loc:Tr 面板位置}" Classes="fieldlabel" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PreviewPanelPlacements}"
                        SelectedIndex="{Binding PreviewPanelPlacementIndex, Mode=TwoWay}"
                        MinWidth="160" HorizontalAlignment="Left" />
            </Grid>
          </StackPanel>

          <!-- Terminal -->
          <StackPanel IsVisible="{Binding ShowTerminal}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 终端}" Classes="h2" />
              <TextBlock Text="{loc:Tr 扫描系统中的终端，选择默认终端和右键菜单项目}" Classes="caption" />
            </StackPanel>

            <TextBlock Text="{loc:Tr 检测方式}" Classes="section" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="chip" Tag="Auto" Click="OnTerminalModeClick"
                      Classes.active="{Binding TerminalMode, Converter={StaticResource EqualsConverter}, ConverterParameter=Auto}">
                <TextBlock Text="{loc:Tr 自动探测}" />
              </Button>
              <Button Classes="chip" Tag="Manual" Click="OnTerminalModeClick"
                      Classes.active="{Binding TerminalMode, Converter={StaticResource EqualsConverter}, ConverterParameter=Manual}">
                <TextBlock Text="{loc:Tr 手动路径}" />
              </Button>
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowTerminalAuto}" Spacing="8">
              <TextBlock Classes="fieldhint" Text="{loc:Tr 左侧圆点设为默认终端，右侧复选框控制哪些终端出现在右键菜单。}"
                         TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding TerminalScanSummary}" Classes="fieldhint" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{loc:Tr 重新扫描}" Classes="link"
                        Click="OnRescanTerminalsClick" />
              </Grid>

              <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10" Margin="10,0,10,0"
                    IsVisible="{Binding HasTerminals}">
                <TextBlock Text="{loc:Tr 默认}" Classes="fieldhint" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{loc:Tr 终端}" Classes="fieldhint" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Terminals}" IsVisible="{Binding HasTerminals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TerminalSettingViewModel">
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="10,7"
                            Margin="0,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                      <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
                        <RadioButton GroupName="DefaultTerminal" VerticalAlignment="Center"
                                     IsChecked="{Binding IsDefault, Mode=OneWay}"
                                     IsVisible="{Binding CanBeDefault}"
                                     Tag="{Binding Id}" Click="OnTerminalDefaultClick"
                                     ToolTip.Tip="{loc:Tr 设为默认终端}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                    Padding="5,0" IsVisible="{Binding IsHerdr}">
                              <TextBlock Text="{loc:Tr 终端复用器}" Classes="tiny"
                                         Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Detail}" Classes="tiny"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="fieldhint" Text="{loc:Tr 默认不启用；启用后右键菜单会出现“在 Herdr 中打开”。}"
                                     IsVisible="{Binding IsHerdr}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Content="{loc:Tr 在右键菜单显示}"
                                  IsChecked="{Binding ShowInContextMenu, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{loc:Tr 未检测到终端。可切换到手动路径模式指定可执行文件。}"
                         Classes="fieldhint" TextWrapping="Wrap"
                         IsVisible="{Binding !HasTerminals}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowTerminalManual}" Spacing="8">
              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="{loc:Tr 名称}" Classes="fieldlabel" />
                <TextBox Grid.Column="1" Text="{Binding ManualTerminalName, Mode=TwoWay}"
                         PlaceholderText="{loc:Tr 自定义终端}" />

                <TextBlock Grid.Row="1" Text="{loc:Tr 可执行文件}" Classes="fieldlabel" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding ManualTerminalPath, Mode=TwoWay}"
                           PlaceholderText="{loc:Tr 例如 /usr/bin/kitty}" />
                  <Button Grid.Column="1" Content="{loc:Tr 浏览…}" Classes="chip"
                          Click="OnBrowseTerminalClick" />
                </Grid>

                <TextBlock Grid.Row="2" Text="{loc:Tr 打开文件夹参数}" Classes="fieldlabel" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ManualTerminalArguments, Mode=TwoWay}"
                         PlaceholderText="--working-directory=%d" />

                <TextBlock Grid.Row="3" Text="{loc:Tr 运行命令参数}" Classes="fieldlabel" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding ManualTerminalCommandArguments, Mode=TwoWay}"
                         PlaceholderText="-e sh -lc %c" />
              </Grid>
              <TextBlock Text="{Binding TerminalError}" Classes="fieldhint"
                         Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                         IsVisible="{Binding TerminalError, Converter={StaticResource NotNullConverter}}" />
              <TextBlock Classes="fieldhint" Text="{loc:Tr 在参数中使用 %d 表示文件夹，%c 表示要运行的命令。留空时使用进程工作目录。}"
                         TextWrapping="Wrap" />
              <TextBlock Classes="fieldhint" Text="{loc:Tr 手动模式只使用这里指定的终端；自动探测模式按上面的勾选决定默认终端和右键菜单。}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Classes="fieldhint" Text="{loc:Tr Herdr 会作为独立的“在 Herdr 中打开”菜单项显示，默认不启用。它需要当前终端支持运行命令。}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <!-- Custom commands -->
          <StackPanel IsVisible="{Binding ShowCommands}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 命令}" Classes="h2" />
              <TextBlock Text="{loc:Tr 用占位符运行脚本和快捷动作，适合开发者和运维}" Classes="caption" />
            </StackPanel>

            <TextBlock Text="{loc:Tr 占位符}" Classes="section" />
            <TextBlock Classes="fieldhint" Text="{loc:Tr %f 第一个选中项的路径；%F 所有选中项的路径；%n 第一个名称；%N 所有名称；%d 当前文件夹；%p 选中项所在文件夹；%% 百分号。占位符会自动加引号，无需再手动加引号。}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="fieldhint" Text="{loc:Tr 工作目录留空或使用 %d 表示当前文件夹；使用 %f 或 %p 时会自动取对应文件夹。}"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="fieldhint" Text="{loc:Tr 勾选“在右键菜单显示”时会出现在右键菜单；所有命令都会加入命令面板。}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
              <Button Grid.Column="1" Content="{loc:Tr 添加命令}" Classes="chip"
                      Click="OnAddCustomCommandClick" />
            </Grid>

            <ItemsControl ItemsSource="{Binding CustomCommands}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CustomCommandViewModel">
                  <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="10,8"
                          Margin="0,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                      <TextBox Text="{Binding Name, Mode=TwoWay}"
                               PlaceholderText="{loc:Tr 命令名称}" />
                      <Button Grid.Column="1" Classes="tool" Width="24" Height="24" Margin="8,0,0,0"
                              Tag="{Binding Id}" Click="OnRemoveCustomCommandClick"
                              ToolTip.Tip="{loc:Tr 删除}">
                        <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stretch="Uniform"
                              Fill="{DynamicResource TextTertiaryBrush}" />
                      </Button>

                      <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding Command, Mode=TwoWay}"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               PlaceholderText="{loc:Tr 例如：code %f 或 ./scripts/deploy.sh %d}" />

                      <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="120,*" ColumnSpacing="8">
                        <TextBlock Text="{loc:Tr 工作目录}" Classes="fieldlabel" />
                        <TextBox Grid.Column="1" Text="{Binding WorkingDirectory, Mode=TwoWay}"
                                 PlaceholderText="%d" />
                      </Grid>

                      <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <CheckBox Content="{loc:Tr 在右键菜单显示}"
                                  IsChecked="{Binding ShowInContextMenu, Mode=TwoWay}" Margin="0,0,14,0" />
                        <CheckBox Content="{loc:Tr 在终端中运行}"
                                  IsChecked="{Binding RunInTerminal, Mode=TwoWay}" Margin="0,0,14,0" />
                        <CheckBox Content="{loc:Tr 仅在有选中项时可用}"
                                  IsChecked="{Binding RequiresSelection, Mode=TwoWay}" Margin="0,0,14,0" />
                        <CheckBox Content="{loc:Tr 固定到工具栏}"
                                  IsChecked="{Binding PinnedToToolbar, Mode=TwoWay}" Margin="0,0,14,0" />
                        <CheckBox Content="{loc:Tr 运行前确认}"
                                  IsChecked="{Binding ConfirmBeforeRun, Mode=TwoWay}" Margin="0,0,14,0" />
                        <CheckBox Content="{loc:Tr 将选中路径写入标准输入}"
                                  IsChecked="{Binding PipeSelectionToStdin, Mode=TwoWay}" />
                      </WrapPanel>

                      <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="120,*" ColumnSpacing="8">
                        <TextBlock Text="{loc:Tr 环境变量}" Classes="fieldlabel" VerticalAlignment="Top" />
                        <TextBox Grid.Column="1" Text="{Binding EnvironmentVariables, Mode=TwoWay}"
                                 AcceptsReturn="True" MinHeight="48" MaxHeight="90"
                                 FontFamily="{DynamicResource MonoFontFamily}"
                                 PlaceholderText="KEY=VALUE" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{loc:Tr 还没有自定义命令}" Classes="fieldhint"
                       IsVisible="{Binding !HasCustomCommands}" />
          </StackPanel>

          <!-- Network -->
          <StackPanel IsVisible="{Binding ShowNetwork}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 网络}" Classes="h2" />
              <TextBlock Text="{loc:Tr 管理已保存的远程连接}" Classes="caption" />
            </StackPanel>

            <TextBlock Classes="fieldhint" Text="{loc:Tr 管理已保存的远程连接。隐藏设置随保存生效，复制和删除会立即生效。}"
                       TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Connections}" IsVisible="{Binding HasConnections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConnectionSettingViewModel">
                  <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="10,7"
                          Margin="0,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                      <CheckBox Content="{loc:Tr 显示}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                VerticalAlignment="Center" ToolTip.Tip="{loc:Tr 在侧栏中显示}" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Classes="tiny" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Error}" Classes="tiny" Foreground="{DynamicResource ErrorBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Error}"
                                   IsVisible="{Binding IsFailed}" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{loc:Tr 复制}" Classes="link" Tag="{Binding Id}"
                              Click="OnDuplicateConnectionClick" />
                      <Button Grid.Column="3" Content="{loc:Tr 删除}" Classes="link" Tag="{Binding Id}"
                              Click="OnDeleteConnectionClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{loc:Tr 还没有保存的远程连接}" Classes="fieldhint"
                       IsVisible="{Binding !HasConnections}" />
          </StackPanel>

          <!-- Behaviour -->
          <StackPanel IsVisible="{Binding ShowBehavior}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 行为与撤销}" Classes="h2" />
              <TextBlock Text="{loc:Tr 确认、会话恢复与撤销范围}" Classes="caption" />
            </StackPanel>

            <TextBlock Text="{loc:Tr 行为与安全}" Classes="section" />
            <StackPanel Spacing="7">
              <CheckBox Content="{loc:Tr 永久删除前请求确认}" IsChecked="{Binding ConfirmPermanentDelete, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 启动时恢复上次的标签页与分屏}" IsChecked="{Binding RestoreSession, Mode=TwoWay}" />
            </StackPanel>

            <Border Classes="divider" />

            <TextBlock Text="{loc:Tr 撤销与重做}" Classes="section" />
            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                <TextBlock Text="{loc:Tr 撤销行为}" Classes="fieldlabel" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding UndoBehaviors}"
                          SelectedIndex="{Binding UndoBehaviorIndex, Mode=TwoWay}"
                          MinWidth="210" HorizontalAlignment="Left" />
              </Grid>
              <TextBlock Classes="fieldhint" Text="{loc:Tr Windows 和 macOS 默认完整撤销（包括复制）；Linux 默认只撤销重命名、移动、回收站和新建。}"
                         TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Content="{loc:Tr 清除撤销历史}" Classes="link" Click="OnClearUndoHistoryClick" />
                <TextBlock Grid.Column="1" Text="{Binding UndoStatus}" Classes="caption"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- System -->
          <StackPanel IsVisible="{Binding ShowSystem}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 系统与集成}" Classes="h2" />
              <TextBlock Text="{loc:Tr 多实例、默认文件管理器与打开方式}" Classes="caption" />
            </StackPanel>

            <TextBlock Text="{loc:Tr 窗口与多实例}" Classes="section" />
            <StackPanel Spacing="8">
              <CheckBox Content="{loc:Tr 单实例模式（再次启动时复用当前进程）}"
                        IsChecked="{Binding SingleInstance, Mode=TwoWay}" />
              <CheckBox Content="{loc:Tr 允许同时打开多个窗口}"
                        IsChecked="{Binding AllowMultipleWindows, Mode=TwoWay}" />
              <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                <TextBlock Text="{loc:Tr 打开文件夹时}" Classes="fieldlabel" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FolderOpenModes}"
                          SelectedIndex="{Binding FolderOpenIndex, Mode=TwoWay}"
                          IsEnabled="{Binding AllowMultipleWindows}" MinWidth="160"
                          HorizontalAlignment="Left" />
              </Grid>
              <TextBlock Classes="fieldhint" Text="{loc:Tr 来自浏览器、IDE、命令行或其他应用的文件夹请求会按此设置打开。}"
                         TextWrapping="Wrap" />
              <TextBlock Classes="fieldhint" Text="{loc:Tr 单实例设置会在下次启动 Ordoa 时生效。}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="divider" IsVisible="{Binding IsLinux}" />

            <TextBlock Text="{loc:Tr 系统集成}" Classes="section" IsVisible="{Binding IsLinux}" />
            <StackPanel Spacing="6" IsVisible="{Binding IsLinux}">
              <TextBlock Classes="fieldhint" Text="{loc:Tr 将 Ordoa 注册为默认文件管理器，并安装 org.freedesktop.FileManager1 D-Bus 服务。}"
                         TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Content="{loc:Tr 设为默认文件管理器}" Classes="subtle"
                        Click="OnRegisterFileManagerClick" IsEnabled="{Binding !IsRegisteringFileManager}" />
                <TextBlock Grid.Column="1" Text="{Binding IntegrationStatus}" Classes="caption"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>

            <Border Classes="divider" IsVisible="{Binding IsPlatformIntegrationSupported}" />

            <TextBlock Text="{loc:Tr 系统菜单集成}" Classes="section"
                       IsVisible="{Binding IsPlatformIntegrationSupported}" />
            <StackPanel Spacing="8" IsVisible="{Binding IsPlatformIntegrationSupported}">
              <CheckBox IsVisible="{Binding IsWindows}"
                        Content="{loc:Tr 添加“Open in Ordoa”和“在此处打开 Ordoa”资源管理器菜单}"
                        IsChecked="{Binding WindowsShellIntegrationEnabled, Mode=TwoWay}" />
              <CheckBox IsVisible="{Binding IsMacOS}"
                        Content="{loc:Tr 安装“在 Ordoa 中打开”Finder 快速操作}"
                        IsChecked="{Binding MacFinderServiceEnabled, Mode=TwoWay}" />
              <TextBlock Classes="fieldhint"
                         Text="{loc:Tr 这些选项默认关闭，只写入当前用户的注册表或 ~/Library/Services，不会修改系统级设置。}"
                         TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Content="{loc:Tr 应用系统集成}" Classes="subtle"
                        Click="OnApplyPlatformIntegrationClick"
                        IsEnabled="{Binding !IsApplyingPlatformIntegration}" />
                <TextBlock Grid.Column="1" Text="{Binding PlatformIntegrationStatus}" Classes="caption"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>

            <Border Classes="divider" IsVisible="{Binding IsLinux}" />

            <TextBlock Text="{loc:Tr 打开方式}" Classes="section" IsVisible="{Binding IsLinux}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsLinux}">
              <TextBlock Text="{Binding OpenWithSummary}" Classes="caption" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="{loc:Tr 清除已记住的选择}" Classes="link"
                      HorizontalAlignment="Left" Click="OnClearOpenWithClick"
                      IsEnabled="{Binding HasOpenWithDefaults}" />
            </Grid>

            <Border Classes="divider" />

            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr 设置保存在}" Classes="section" />
              <TextBlock Text="{Binding SettingsPath}" Classes="tiny" FontFamily="{DynamicResource MonoFontFamily}" />
            </StackPanel>
          </StackPanel>

          <!-- Keyboard shortcuts -->
          <StackPanel IsVisible="{Binding ShowShortcuts}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr 快捷键}" Classes="h2" />
              <TextBlock Text="{loc:Tr 为常用操作自定义键盘组合；留空即可禁用。}" Classes="caption" />
            </StackPanel>

            <TextBlock Text="{Binding ShortcutConflictText}" Foreground="{DynamicResource ErrorBrush}"
                       Classes="fieldhint" TextWrapping="Wrap"
                       IsVisible="{Binding HasShortcutConflicts}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="fieldhint" Text="{loc:Tr 使用 Ctrl / Shift / Alt / Meta 加键名，例如 Ctrl+Shift+T。}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
              <Button Grid.Column="1" Content="{loc:Tr 全部恢复默认}" Classes="ghost"
                      Click="OnResetShortcutsClick" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Shortcuts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutSettingViewModel">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="12" Margin="0,3">
                    <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBox Text="{Binding Gesture, Mode=TwoWay}" Width="190"
                               HorizontalAlignment="Left"
                               FontFamily="{DynamicResource MonoFontFamily}" />
                      <TextBlock Text="{Binding Error}" Classes="fieldhint"
                                 Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                 IsVisible="{Binding HasError}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Git -->
          <StackPanel IsVisible="{Binding ShowGit}" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr Git}" Classes="h2" />
              <TextBlock Text="{loc:Tr 仓库状态、分支与未提交变更标记}" Classes="caption" />
            </StackPanel>

            <TextBlock Text="{loc:Tr 显示}" Classes="section" />
            <StackPanel Spacing="7">
              <CheckBox Content="{loc:Tr 启用 Git 集成}" IsChecked="{Binding EnableGitIntegration, Mode=TwoWay}" />
              <StackPanel Spacing="7" IsEnabled="{Binding EnableGitIntegration}">
                <CheckBox Content="{loc:Tr 在状态栏显示分支与变更数量}"
                          IsChecked="{Binding ShowGitStatusBar, Mode=TwoWay}" />
                <CheckBox Content="{loc:Tr 在文件和文件夹上显示 Git 标记}"
                          IsChecked="{Binding ShowGitFileBadges, Mode=TwoWay}" />
                <CheckBox Content="{loc:Tr 已跟踪且无变更的文件/文件夹显示绿色勾}"
                          IsChecked="{Binding ShowGitCleanCheck, Mode=TwoWay}" />
                <CheckBox Content="{loc:Tr 在文件夹外显示 Git 仓库标记}"
                          IsChecked="{Binding ShowGitRepositoryBadges, Mode=TwoWay}" />
                <CheckBox Content="{loc:Tr 显示子模块特殊标记}"
                          IsChecked="{Binding ShowGitSubmoduleBadges, Mode=TwoWay}" />
                <CheckBox Content="{loc:Tr 淡显被 Git 忽略的文件（显示 I 标记）}"
                          IsChecked="{Binding DimGitIgnored, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>

            <Border Classes="divider" />

            <TextBlock Classes="fieldhint" Text="{loc:Tr Git 状态是只读的，仅调用系统 PATH 中的 git status，不会暂存或提交。}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="fieldhint" Text="{loc:Tr 需要安装 Git 命令行工具；未安装时这些开关不会影响文件浏览。}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Padding="18,10,18,14" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Content="{loc:Tr 恢复默认值}" Classes="ghost" Click="OnResetClick" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Tr 取消}" Click="OnCancelClick" />
          <Button Content="{loc:Tr 保存}" Classes="accent" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
