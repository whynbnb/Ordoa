<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Ordoa.App.Views"
             x:Class="Ordoa.App.Views.TabView">
  <UserControl.Styles>
    <Style Selector="Border.panehost">
      <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,Auto,*" Background="{DynamicResource WindowBackgroundBrush}">
    <Border Grid.Column="0" Classes="panehost">
      <views:PaneView DataContext="{Binding PrimaryPane}" />
    </Border>
    <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" IsVisible="{Binding IsSplit}"
                  Background="Transparent" ResizeDirection="Columns" />
    <Border x:Name="SecondaryHost" Grid.Column="2" Classes="panehost" IsVisible="{Binding IsSplit}">
      <views:PaneView DataContext="{Binding SecondaryPane}" />
    </Border>
  </Grid>
</UserControl>
