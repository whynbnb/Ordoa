<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Ordoa.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ordoa.App.ViewModels"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True"
             x:Class="Ordoa.App.Views.SidebarView">
  <UserControl.Resources>
    <DataTemplate x:Key="SidebarEntryTemplate" DataType="{x:Type vm:SidebarEntryViewModel}" x:DataType="vm:SidebarEntryViewModel">
    <Button Classes="sidebaritem"
            Classes.active="{Binding IsActive}"
            Classes.drop="{Binding IsDropTarget}"
            Click="OnEntryClick"
            ContextRequested="OnEntryContextRequested"
            ToolTip.Tip="{Binding Detail}"
            DragDrop.AllowDrop="True"
            DragDrop.DragOver="OnEntryDragOver"
            DragDrop.DragLeave="OnEntryDragLeave"
            DragDrop.Drop="OnEntryDrop">
      <Panel>
        <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,2" VerticalAlignment="Center">
          <Path Data="{Binding Icon}" Fill="{Binding IconBrush}"
                Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                Margin="0,0,9,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Label}" Classes="sidebarlabel" />
            <TextBlock Text="{Binding Detail}" Classes="sidebardetail"
                       IsVisible="{Binding Detail, Converter={StaticResource NotNullConverter}}" />
          </StackPanel>
        </Grid>
        <ProgressBar Height="2" MinHeight="2"
                     VerticalAlignment="Bottom" Margin="24,0,4,0"
                     Value="{Binding UsageFraction}" Maximum="1"
                     IsVisible="{Binding ShowUsage}" />
      </Panel>
    </Button>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.sidebaritem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ItemsControl.sidebar > ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ItemsControl.sidebaritems > ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="StackPanel.sidebarsection">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.sidebaritem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sidebaritem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.sidebaritem.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.sidebaritem.drop /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.sidebaritem.drop TextBlock.sidebarlabel">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.sidebaritem.active TextBlock.sidebarlabel">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.sectionadd Path">
      <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Button.sectionadd:pointerover Path">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.sidebarlabel">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sidebardetail">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <Border Padding="14,12,10,8" PointerPressed="OnSidebarHeaderPointerPressed">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Column="0" Width="76" IsVisible="{Binding ReserveMacOSTrafficLights}" />
        <Image Grid.Column="1" Source="/Assets/ordoa.png" Width="28" Height="28" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Margin="9,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Ordoa" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{loc:Tr 安序 · 文件管理}" Classes="tiny" />
        </StackPanel>
        <Button Grid.Column="3" Classes="tool" Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="{loc:Tr 收起侧栏 (F9)}" VerticalAlignment="Center">
          <Path Data="{StaticResource IconPanel}" Width="16" Height="16" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="8,2,8,10" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl Classes="sidebar" ItemsSource="{Binding SidebarSections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:SidebarSectionViewModel}" x:DataType="vm:SidebarSectionViewModel">
            <StackPanel Classes="sidebarsection" Margin="0,3,0,7">
              <Grid ColumnDefinitions="*,Auto" Margin="9,5,6,4">
                <TextBlock Text="{Binding Title}" Classes="section" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="tool sectionadd" Width="20" Height="20"
                        IsVisible="{Binding HasHeaderAction}" ToolTip.Tip="{Binding HeaderTooltip}"
                        Click="OnSectionHeaderClick">
                  <Path Data="{Binding HeaderIcon}" Width="12" Height="12" Stretch="Uniform" />
                </Button>
              </Grid>
              <ItemsControl Classes="sidebaritems" ItemsSource="{Binding Items}"
                            ItemTemplate="{StaticResource SidebarEntryTemplate}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="8,5,8,4"
            IsVisible="{Binding SystemSection, Converter={StaticResource NotNullConverter}}">
      <StackPanel Classes="sidebarsection">
        <TextBlock Text="{Binding SystemSection.Title}" Classes="section" Margin="9,3,8,3" />
        <ItemsControl Classes="sidebaritems" ItemsSource="{Binding SystemSection.Items}"
                      ItemTemplate="{StaticResource SidebarEntryTemplate}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="8,7,8,10">
      <StackPanel>
        <Button Classes="sidebaritem" Click="OnSettingsClick">
          <Grid ColumnDefinitions="Auto,*">
            <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource TextSecondaryBrush}"
                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0" />
            <TextBlock Grid.Column="1" Text="{loc:Tr 设置}" Classes="sidebarlabel" />
          </Grid>
        </Button>
        <Button Classes="sidebaritem" Click="OnAboutClick">
          <Grid ColumnDefinitions="Auto,*">
            <Path Data="{StaticResource IconKeyboard}" Fill="{DynamicResource TextSecondaryBrush}"
                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0" />
            <TextBlock Grid.Column="1" Text="{loc:Tr 关于与快捷键}" Classes="sidebarlabel" />
          </Grid>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
