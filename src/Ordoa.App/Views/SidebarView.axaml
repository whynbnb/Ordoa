<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ordoa.App.ViewModels"
             x:Class="Ordoa.App.Views.SidebarView">
  <UserControl.Styles>
    <Style Selector="Button.sidebaritem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ItemsControl.sidebar > ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ItemsControl.sidebaritems > ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="StackPanel.sidebarsection">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.sidebaritem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sidebaritem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.sidebaritem.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.sidebaritem.active TextBlock.sidebarlabel">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sidebarlabel">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sidebardetail">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="14,12,10,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Source="/Assets/ordoa.png" Width="28" Height="28" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Ordoa" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="安序 · 文件管理" Classes="tiny" />
        </StackPanel>
        <Button Grid.Column="2" Classes="tool" Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="收起侧栏 (F9)" VerticalAlignment="Center">
          <Path Data="{StaticResource IconPanel}" Width="16" Height="16" Stretch="Uniform"
                Fill="{DynamicResource TextSecondaryBrush}" />
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="8,2,8,10" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl Classes="sidebar" ItemsSource="{Binding SidebarSections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:SidebarSectionViewModel}">
            <StackPanel Classes="sidebarsection" Margin="0,3,0,7">
              <TextBlock Text="{Binding Title}" Classes="section" Margin="9,5,8,4" />
              <ItemsControl Classes="sidebaritems" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:SidebarEntryViewModel}">
                    <Button Classes="sidebaritem"
                            Classes.active="{Binding IsActive}"
                            Click="OnEntryClick"
                            ContextRequested="OnEntryContextRequested"
                            ToolTip.Tip="{Binding Detail}">
                      <Panel>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,2">
                          <Path Grid.RowSpan="2" Data="{Binding Icon}" Fill="{Binding IconBrush}"
                                Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                                Margin="0,0,9,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="sidebarlabel" />
                          <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Detail}"
                                     Classes="sidebardetail" IsVisible="{Binding Detail, Converter={StaticResource NotNullConverter}}" />
                        </Grid>
                        <ProgressBar Height="2" MinHeight="2"
                                     VerticalAlignment="Bottom" Margin="24,0,4,0"
                                     Value="{Binding UsageFraction}" Maximum="1"
                                     IsVisible="{Binding ShowUsage}" />
                      </Panel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="8,7,8,10">
      <StackPanel>
        <Button Classes="sidebaritem" Click="OnSettingsClick">
          <Grid ColumnDefinitions="Auto,*">
            <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource TextSecondaryBrush}"
                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0" />
            <TextBlock Grid.Column="1" Text="设置" Classes="sidebarlabel" />
          </Grid>
        </Button>
        <Button Classes="sidebaritem" Click="OnAboutClick">
          <Grid ColumnDefinitions="Auto,*">
            <Path Data="{StaticResource IconKeyboard}" Fill="{DynamicResource TextSecondaryBrush}"
                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0" />
            <TextBlock Grid.Column="1" Text="关于与快捷键" Classes="sidebarlabel" />
          </Grid>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
