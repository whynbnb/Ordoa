<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:Ordoa.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ordoa.App.ViewModels.Dialogs"
        x:DataType="vm:ImageConversionDialogViewModel"
        x:CompileBindings="True"
        x:Class="Ordoa.App.Views.ImageConversionWindow"
        Title="{loc:Tr 批量转换图片}"
        Width="700" Height="620" MinWidth="520" MinHeight="420" CanResize="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Padding="22,15" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Tr 批量转换图片}" Classes="h2" />
          <TextBlock Text="{Binding SummaryText}" Classes="caption" />
        </StackPanel>
        <Button Grid.Column="1" Content="{loc:Tr 关闭}" Click="OnCloseClick" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="card" Padding="14,10" Margin="16,12,16,4">
      <Grid ColumnDefinitions="110,160,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
        <TextBlock Text="{loc:Tr 输出格式}" Classes="fieldlabel" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}"
                  MinWidth="120" HorizontalAlignment="Left" />
        <TextBlock Grid.Column="2" Text="{loc:Tr JPEG/WebP 使用质量设置}" Classes="fieldhint"
                   VerticalAlignment="Center" Margin="10,0,0,0" />

        <TextBlock Grid.Row="1" Text="{loc:Tr 质量}" Classes="fieldlabel" />
        <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="100" Increment="1" FormatString="0"
                       Value="{Binding Quality, Mode=TwoWay}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr 1–100，默认 85}" Classes="fieldhint"
                   VerticalAlignment="Center" Margin="10,0,0,0" />

        <TextBlock Grid.Row="2" Text="{loc:Tr 最大边长}" Classes="fieldlabel" />
        <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="20000" Increment="100" FormatString="0"
                       Value="{Binding MaxDimension, Mode=TwoWay}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Tr 像素；0 表示保持原始尺寸}" Classes="fieldhint"
                   VerticalAlignment="Center" Margin="10,0,0,0" />

        <TextBlock Grid.Row="3" Text="{loc:Tr 输出文件夹}" Classes="fieldlabel" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding OutputDirectory, Mode=TwoWay}"
                 FontFamily="{DynamicResource MonoFontFamily}" />
        <Button Grid.Row="3" Grid.Column="3" Content="{loc:Tr 浏览…}" Classes="subtle"
                Command="{Binding BrowseCommand}" Margin="8,0,0,0" />

        <TextBlock Grid.Row="4" Text="{loc:Tr 文件名后缀}" Classes="fieldlabel" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Suffix, Mode=TwoWay}"
                 FontFamily="{DynamicResource MonoFontFamily}" />
        <TextBlock Grid.Row="4" Grid.Column="2" Text="{loc:Tr 避免覆盖原文件；留空时自动改名}" Classes="fieldhint"
                   VerticalAlignment="Center" Margin="10,0,0,0" />
      </Grid>
    </Border>

    <ProgressBar Grid.Row="2" Height="3" Value="{Binding Progress}" Maximum="1"
                 VerticalAlignment="Top" Margin="16,6,16,0" IsVisible="{Binding IsRunning}" />

    <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" Background="Transparent" SelectionMode="Single"
             Margin="16,8,16,4" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ImageConversionRowViewModel">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="2,2">
            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="tiny"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" MaxWidth="320" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="3" Padding="18,12" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{loc:Tr 关闭}" Click="OnCloseClick" />
        <Button Content="{loc:Tr 开始转换}" Classes="accent" Command="{Binding StartCommand}"
                IsEnabled="{Binding CanStart}" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
