<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Ordoa.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Ordoa.App.Views"
        xmlns:vm="using:Ordoa.App.ViewModels"
        xmlns:models="using:Ordoa.Core.Models"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        xmlns:services="using:Ordoa.App.Services"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:xt="using:Avalonia.Markup.Xaml.Templates"
        x:Class="Ordoa.App.Views.MainWindow"
        x:Name="ThisWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/ordoa.ico"
        Width="1200" Height="760"
        MinWidth="840" MinHeight="540"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Keep WindowDecorations=Full so Windows keeps native resize,
         snapping and minimize/maximize animations, but remove the default
         Fluent title text and caption buttons. MainWindow draws its own
         title bar in the client area. -->
    <ControlTheme x:Key="{x:Type chrome:WindowDrawnDecorations}"
                  TargetType="chrome:WindowDrawnDecorations">
      <Setter Property="DefaultTitleBarHeight" Value="0" />
      <Setter Property="DefaultFrameThickness" Value="1" />
      <Setter Property="DefaultShadowThickness" Value="0" />
      <Setter Property="Template">
        <xt:WindowDrawnDecorationsTemplate>
          <chrome:WindowDrawnDecorationsContent>
            <chrome:WindowDrawnDecorationsContent.Underlay>
              <Panel x:Name="PART_UnderlayWrapper">
                <Border x:Name="PART_WindowBorder"
                        Background="Transparent"
                        BorderThickness="{TemplateBinding FrameThickness}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        IsHitTestVisible="False" />
              </Panel>
            </chrome:WindowDrawnDecorationsContent.Underlay>
          </chrome:WindowDrawnDecorationsContent>
        </xt:WindowDrawnDecorationsTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Border.tab.active">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.tab.pinned">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.tab TextBlock.tabtitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MaxWidth" Value="180" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,4,0" />
    </Style>
    <Style Selector="Border.tab.active TextBlock.tabtitle">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.tab Path.tabicon">
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.tab.active Path.tabicon">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.tab Button.tabclose">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.tab:pointerover Button.tabclose">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.tab.active Button.tabclose">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="MaxWidth" Value="380" />
      <Setter Property="MinWidth" Value="260" />
    </Style>
    <Style Selector="Border.toast.error">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Border.toast.success">
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Button.tabadd">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Margin" Value="3,0,0,0" />
    </Style>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.caption /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.caption.close:pointerover Path">
      <Setter Property="Fill" Value="White" />
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid" ColumnDefinitions="Auto,0,*">
    <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
            IsVisible="{Binding IsSidebarVisible}">
      <views:SidebarView />
    </Border>

    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1" Height="41" PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="8,0,8,0">
          <Border Grid.Column="0" Width="76" IsVisible="{Binding ReserveMacOSTrafficLightsInTitleBar}" />
          <Button Grid.Column="1" Classes="tool" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{loc:Tr 显示/隐藏侧栏 (F9)}"
                  VerticalAlignment="Center" Width="28" Height="28">
            <Path Data="{StaticResource IconPanel}" Width="15" Height="15" Stretch="Uniform"
                  Fill="{DynamicResource TextSecondaryBrush}" />
          </Button>

          <ScrollViewer x:Name="TabScroller" Grid.Column="2" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled" PointerWheelChanged="OnTabScrollerWheel"
                        DragDrop.AllowDrop="True" DragDrop.DragOver="OnTabStripDragOver"
                        DragDrop.Drop="OnTabStripDrop" Margin="6,0,6,0">
            <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TabViewModel">
                  <Border Classes="tab" Classes.pinned="{Binding IsPinned}"
                          Classes.active="{Binding IsActive}"
                          PointerPressed="OnTabPointerPressed"
                          PointerMoved="OnTabPointerMoved"
                          PointerReleased="OnTabPointerReleased"
                          PointerCaptureLost="OnTabPointerCaptureLost"
                          ToolTip.Tip="{Binding Tooltip}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                      <Path Classes="tabicon" Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform"
                            VerticalAlignment="Center" />
                      <Path Grid.Column="1" Data="{StaticResource IconStar}" Width="9" Height="9"
                            Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" Margin="4,0,0,0"
                            IsVisible="{Binding IsPinned}" />
                      <TextBlock Grid.Column="2" Text="{Binding Title}" Classes="tabtitle" />
                      <Path Grid.Column="3" Data="{StaticResource IconSplit}" Width="10" Height="10"
                            Stretch="Uniform" Fill="{DynamicResource TextTertiaryBrush}"
                            VerticalAlignment="Center" Margin="0,0,3,0"
                            IsVisible="{Binding IsSplit}" />
                      <Button Grid.Column="4" Classes="tabclose" Click="OnTabCloseClick"
                              ToolTip.Tip="{loc:Tr 关闭标签页}">
                        <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stretch="Uniform"
                              Fill="{DynamicResource TextSecondaryBrush}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="1">
            <Button Classes="tabadd" Command="{Binding NewTabCommand}" ToolTip.Tip="{loc:Tr 新建标签页 (Ctrl+T)}">
              <Path Data="{StaticResource IconPlus}" Width="14" Height="14" Stretch="Uniform"
                    Fill="{DynamicResource TextSecondaryBrush}" />
            </Button>

            <Button Classes="tool" Command="{Binding TogglePreviewPanelCommand}"
                    ToolTip.Tip="{loc:Tr 预览面板 (F3)}" Width="28" Height="28">
              <Path Data="{StaticResource IconEye}" Width="15" Height="10.5" Stretch="Uniform"
                    VerticalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}" />
            </Button>

            <Panel Margin="3,0,0,0">
              <Button Classes="tool" Command="{Binding ToggleTransferPanelCommand}" ToolTip.Tip="{loc:Tr 传输队列}"
                      Width="28" Height="28">
                <Path Data="{StaticResource IconSync}" Width="15" Height="15" Stretch="Uniform"
                      Fill="{DynamicResource TextSecondaryBrush}" />
              </Button>
              <Border Background="{DynamicResource AccentBrush}" CornerRadius="6"
                      MinWidth="13" Height="13" Padding="2,0" IsVisible="{Binding ActiveTransferCount, Converter={StaticResource CountToBoolConverter}}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0">
                <TextBlock Text="{Binding ActiveTransferCount}" FontSize="8.5" FontWeight="Bold"
                           Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </Panel>

            <Button Classes="tool" IsVisible="{Binding HasToolbarCommands}"
                    ToolTip.Tip="{loc:Tr 固定的自定义动作}" Width="28" Height="28">
              <Path Data="{StaticResource IconStar}" Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource TextSecondaryBrush}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <ItemsControl ItemsSource="{Binding ToolbarCommands}" MinWidth="200">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:CustomCommand">
                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Padding="8,4"
                                Content="{Binding Name}" Tag="{Binding Id}"
                                Click="OnToolbarCommandClick" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Button Classes="tool" Command="{Binding ShowCommandPaletteCommand}"
                    ToolTip.Tip="{loc:Tr 命令面板 (Ctrl+Shift+P)}" Width="28" Height="28">
              <Path Data="{StaticResource IconCommand}" Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource TextSecondaryBrush}" />
            </Button>

            <Button Classes="tool" ToolTip.Tip="{loc:Tr 更多}" Width="28" Height="28">
              <Path Data="{StaticResource IconDots}" Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource TextSecondaryBrush}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="{loc:Tr 新建标签页}" Command="{Binding NewTabCommand}" />
                  <MenuItem Header="{loc:Tr 复制当前标签页}" Command="{Binding DuplicateActiveTabCommand}" />
                  <MenuItem Header="{loc:Tr 切换分屏}" Command="{Binding ToggleSplitCommand}" />
                  <Separator />
                  <MenuItem Header="{loc:Tr 显示/隐藏隐藏文件}" Command="{Binding ToggleHiddenCommand}" />
                  <MenuItem Header="{loc:Tr 刷新}" Command="{Binding RefreshAllCommand}" />
                  <Separator />
                  <MenuItem Header="{loc:Tr 设置…}" Command="{Binding OpenSettingsCommand}" />
                  <MenuItem Header="{loc:Tr 键盘快捷键与关于}" Command="{Binding OpenAboutCommand}" />
                  <Separator />
                  <MenuItem Header="{loc:Tr 退出 Ordoa}" Click="OnExitClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch"
                      IsVisible="{Binding ShowWindowCaptionButtons}">
            <Button Classes="caption" Click="OnMinimizeWindowClick" ToolTip.Tip="{loc:Tr 最小化}">
              <Path Data="{StaticResource IconMinimizeWindow}" Width="10" Height="1" Stretch="Fill"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource TextSecondaryBrush}" />
            </Button>
            <Button Classes="caption" Click="OnMaximizeRestoreWindowClick" ToolTip.Tip="{loc:Tr 最大化 / 还原}">
              <Panel>
                <Path Data="{StaticResource IconMaximizeWindow}" Width="10" Height="10" Stretch="Uniform"
                      Fill="{DynamicResource TextSecondaryBrush}"
                      IsVisible="{Binding #ThisWindow.WindowState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static WindowState.Normal}}" />
                <Path Data="{StaticResource IconRestoreWindow}" Width="10" Height="10" Stretch="Uniform"
                      Fill="{DynamicResource TextSecondaryBrush}"
                      IsVisible="{Binding #ThisWindow.WindowState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static WindowState.Maximized}}" />
              </Panel>
            </Button>
            <Button Classes="caption close" Click="OnCloseWindowClick" ToolTip.Tip="{loc:Tr 关闭}">
              <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                    Fill="{DynamicResource TextSecondaryBrush}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
        <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding ActiveTab}" />

        <ContentControl Grid.Row="0" Grid.Column="1" Width="340"
                        IsVisible="{Binding ShowPreviewPanelRight}">
          <views:PreviewPanelView />
        </ContentControl>

        <ContentControl Grid.Row="1" Grid.Column="0" Height="300"
                        IsVisible="{Binding ShowPreviewPanelBottom}">
          <views:PreviewPanelView />
        </ContentControl>
      </Grid>

      <views:TransferPanelView Grid.Row="2" IsVisible="{Binding IsTransferPanelOpen}"
                               DataContext="{Binding}" />
    </Grid>

    <!-- Overlays both the sidebar and the content so it keeps a 6px drag
         target without reserving visual space. -->
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Classes="pane" Width="6" MinWidth="0"
                  HorizontalAlignment="Center" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                  IsVisible="{Binding IsSidebarVisible}" DragCompleted="OnSidebarSplitterDragCompleted" />

    <!-- Splash -->
    <Grid Grid.ColumnSpan="3" Background="{DynamicResource WindowBackgroundBrush}"
          IsVisible="{Binding IsInitialized, Converter={StaticResource InverseBoolConverter}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Width="320">
        <Image Source="/Assets/ordoa-mark.png" Width="96" Height="96" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Tr Ordoa}" Classes="h1" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Tr 有秩序的文件管理}" Classes="muted" HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="160" Height="3" Margin="0,8,0,0" />
        <TextBlock Text="{Binding StartupStatus}" Classes="caption" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Toasts -->
    <ItemsControl Grid.ColumnSpan="3" ItemsSource="{Binding Toasts}" ZIndex="50"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,16,0"
                  Width="380">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastViewModel">
          <Border Classes="toast" Classes.error="{Binding IsError}" Classes.success="{Binding IsSuccess}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
              <Path Data="{Binding Icon}" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Top"
                    Fill="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" MaxLines="4"
                           IsVisible="{Binding Message, Converter={StaticResource NotNullConverter}}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="tool" Width="20" Height="20" VerticalAlignment="Top"
                      Click="OnDismissToastClick" ToolTip.Tip="{loc:Tr 关闭}">
                <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stretch="Uniform"
                      Fill="{DynamicResource TextTertiaryBrush}" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Space-bar Quick Look overlay -->
    <Grid Grid.ColumnSpan="3" IsVisible="{Binding Preview.IsOpen}" ZIndex="70"
          Background="{DynamicResource OverlayBrush}" PointerPressed="OnPreviewBackdropPressed">
      <Border x:Name="PreviewCard" Margin="48,36" MaxWidth="1040" MaxHeight="720"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Padding="18,12,12,11" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
              <Path Data="{Binding Preview.Icon}" Width="22" Height="22" Stretch="Uniform"
                    Fill="{Binding Preview.IconBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Preview.Title}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Preview.Subtitle}" Classes="caption"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Classes="tool" Width="28" Height="28"
                      Click="OnPreviewOpenClick" ToolTip.Tip="{loc:Tr 打开}">
                <Path Data="{StaticResource IconOpenExternal}" Width="14" Height="14" Stretch="Uniform"
                      Fill="{DynamicResource TextSecondaryBrush}" />
              </Button>
              <Button Grid.Column="3" Classes="tool" Width="28" Height="28"
                      Click="OnPreviewCloseClick" ToolTip.Tip="{loc:Tr 关闭预览}">
                <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform"
                      Fill="{DynamicResource TextSecondaryBrush}" />
              </Button>
            </Grid>
          </Border>

          <Grid Grid.Row="1" ColumnDefinitions="*,272" Margin="14">
            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9"
                    ClipToBounds="True">
              <views:PreviewContentView DataContext="{Binding Preview}" />
            </Border>

            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Padding="16,2,2,0">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <TextBlock Text="{loc:Tr 详细信息}" Classes="section" />
                  <ItemsControl ItemsSource="{Binding Preview.Details}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="services:PreviewDetail">
                        <Grid ColumnDefinitions="70,*" ColumnSpacing="6" Margin="0,2">
                          <TextBlock Text="{Binding Label}" Classes="tiny" VerticalAlignment="Top" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5"
                                               TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border IsVisible="{Binding Preview.HasNotice}" Background="{DynamicResource AccentSoftBrush}"
                          CornerRadius="7" Padding="9,7">
                    <TextBlock Text="{Binding Preview.Notice}" FontSize="11.5" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>

          <Border Grid.Row="2" Padding="16,9,16,11" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Preview.PathText}" Classes="tiny" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{loc:Tr 空格 / Esc 关闭 · Enter 打开}" Classes="tiny" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Command palette -->
    <Grid Grid.ColumnSpan="3" IsVisible="{Binding IsCommandPaletteOpen}" ZIndex="60"
          Background="{DynamicResource OverlayBrush}" PointerPressed="OnPaletteBackdropPressed">
      <Border Width="640" MaxHeight="520" VerticalAlignment="Top" Margin="0,100,0,0"
              Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="12" ClipToBounds="True" Padding="10">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="Auto,*" Margin="2,0,2,4">
            <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Stretch="Uniform"
                  Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="8,0,8,0" />
            <TextBox x:Name="PaletteSearch" Grid.Column="1" Text="{Binding PaletteQuery, Mode=TwoWay}"
                     PlaceholderText="{loc:Tr 输入命令或搜索操作…}" BorderThickness="0" Background="Transparent"
                     FontSize="14" MinHeight="38" />
          </Grid>

          <ListBox Grid.Row="1" x:Name="PaletteList" ItemsSource="{Binding FilteredCommands}"
                   SelectedItem="{Binding SelectedPaletteCommand, Mode=TwoWay}"
                   MaxHeight="390" Margin="0,2,0,2"
                   DoubleTapped="OnPaletteItemDoubleTapped"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteCommand">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="8,7">
                  <Path Data="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"
                        Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontSize="12.5" />
                    <TextBlock Text="{Binding DisplaySubtitle}" Classes="tiny" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Classes="tiny"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="6,5,6,1">
            <TextBlock Text="{loc:Tr 输入以筛选命令}" Classes="tiny" />
            <TextBlock Grid.Column="1" Classes="tiny">
              <Run Text="{loc:Tr ↑↓ 选择}" /> <Run Text="  ·  " /> <Run Text="{loc:Tr Enter 执行}" /> <Run Text="  ·  " /> <Run Text="{loc:Tr Esc 关闭}" />
            </TextBlock>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
