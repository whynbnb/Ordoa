<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Ordoa.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ordoa.App.ViewModels.Dialogs"
        x:DataType="vm:ChecksumDialogViewModel"
        x:CompileBindings="True"
        x:Class="Ordoa.App.Views.ChecksumWindow"
        Title="{loc:Tr 校验和}"
        Width="720" Height="560" CanResize="True" MinWidth="560" MinHeight="400" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="22,16,22,12" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Tr 校验和}" Classes="h2" />
          <TextBlock Text="{Binding Description}" Classes="caption" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <Button Classes="chip" Tag="Md5" Click="OnAlgorithmClick"
                  Classes.active="{Binding Algorithm, Converter={StaticResource EqualsConverter}, ConverterParameter=Md5}">
            <TextBlock Text="MD5" />
          </Button>
          <Button Classes="chip" Tag="Sha1" Click="OnAlgorithmClick"
                  Classes.active="{Binding Algorithm, Converter={StaticResource EqualsConverter}, ConverterParameter=Sha1}">
            <TextBlock Text="SHA-1" />
          </Button>
          <Button Classes="chip" Tag="Sha256" Click="OnAlgorithmClick"
                  Classes.active="{Binding Algorithm, Converter={StaticResource EqualsConverter}, ConverterParameter=Sha256}">
            <TextBlock Text="SHA-256" />
          </Button>
          <Button Classes="chip" Tag="Sha512" Click="OnAlgorithmClick"
                  Classes.active="{Binding Algorithm, Converter={StaticResource EqualsConverter}, ConverterParameter=Sha512}">
            <TextBlock Text="SHA-512" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="18,12,18,10" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChecksumRowViewModel">
            <Border Classes="card" Padding="12,9" Margin="0,0,0,8">
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Path}" Classes="tiny" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="tiny"
                             VerticalAlignment="Center" />
                </Grid>

                <SelectableTextBlock Text="{Binding Hash}" FontFamily="{DynamicResource MonoFontFamily}"
                                     FontSize="11.5" TextWrapping="Wrap"
                                     IsVisible="{Binding HasHash}" />
                <StackPanel Spacing="2" IsVisible="{Binding HasExpectedHash}">
                  <TextBlock Text="{loc:Tr 校验文件中的值}" Classes="tiny" />
                  <SelectableTextBlock Text="{Binding ExpectedHash}" FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="11" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding VerificationStatus}" Classes="tiny" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding HasVerification}" />
                </StackPanel>
                <TextBlock Text="{loc:Tr 计算中…}" Classes="tiny" IsVisible="{Binding !IsDone}" />
                <ProgressBar Value="{Binding Progress}" Maximum="1" Height="3" MinHeight="3"
                             IsVisible="{Binding !IsDone}" />
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasHash}">
                  <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" Classes="tiny" />
                  <Button Grid.Column="1" Content="{loc:Tr 复制}" Classes="link" FontSize="11"
                          Command="{Binding $parent[Window].DataContext.CopyRowCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" Classes="tiny"
                           IsVisible="{Binding HasError}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="18,10,18,14" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" Classes="caption" />
          <ProgressBar IsIndeterminate="True" Width="70" Height="3" IsVisible="{Binding IsRunning}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Tr 取消计算}" Classes="subtle" Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsRunning}" />
          <Button Content="{loc:Tr 校验文件…}" Classes="subtle" Command="{Binding VerifyFileCommand}" />
          <Button Content="{loc:Tr 复制全部}" Classes="subtle" Command="{Binding CopyAllCommand}"
                  IsEnabled="{Binding HasResults}" />
          <Button Content="{loc:Tr 关闭}" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
