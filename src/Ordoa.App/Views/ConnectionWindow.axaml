<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Ordoa.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ordoa.App.ViewModels.Dialogs"
        xmlns:core="using:Ordoa.Core.Services"
        x:DataType="vm:ConnectionDialogViewModel"
        x:CompileBindings="True"
        x:Class="Ordoa.App.Views.ConnectionWindow"
        Title="{Binding HeaderTitle}"
        Width="600" Height="690" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.fieldlabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.chip.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.chip.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.testerror">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="22,18,22,12" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
          <Path Data="{StaticResource IconCloud}" Width="22" Height="22" Stretch="Uniform"
                Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding HeaderTitle}" Classes="h2" />
          <TextBlock Text="{Binding HeaderSubtitle}" Classes="caption" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="22,14,22,8" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <StackPanel Spacing="6" IsVisible="{Binding HasSshProfiles}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr 从 SSH 配置导入}" Classes="section" />
              <ComboBox ItemsSource="{Binding SshProfiles}" SelectedItem="{Binding SelectedSshProfile, Mode=TwoWay}"
                        PlaceholderText="{loc:Tr 选择 ~/.ssh/config 中的主机别名}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:SshConfigEntry">
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="8">
                      <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayTarget}" Classes="tiny"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:Tr 重新读取}" Classes="subtle"
                    VerticalAlignment="Bottom" Click="OnReloadSshProfilesClick" />
          </Grid>
          <TextBlock Text="{loc:Tr 导入 Host、HostName、User、Port 和 IdentityFile；通配符与 Match 块会被忽略。}"
                     Classes="tiny" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="{loc:Tr 协议}" Classes="section" />
          <WrapPanel ItemWidth="104" ItemHeight="34">
            <Button Classes="chip" Tag="Ftp" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=Ftp}">
              <TextBlock Text="FTP" />
            </Button>
            <Button Classes="chip" Tag="Ftps" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=Ftps}">
              <TextBlock Text="FTPS" />
            </Button>
            <Button Classes="chip" Tag="Sftp" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=Sftp}">
              <TextBlock Text="SFTP" />
            </Button>
            <Button Classes="chip" Tag="Smb" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=Smb}">
              <TextBlock Text="SMB" />
            </Button>
            <Button Classes="chip" Tag="WebDav" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=WebDav}">
              <TextBlock Text="WebDAV" />
            </Button>
            <Button Classes="chip" Tag="S3" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=S3}">
              <TextBlock Text="S3" />
            </Button>
          </WrapPanel>
          <Button Content="{loc:Tr 发现局域网设备…}" Classes="link" HorizontalAlignment="Left"
                  Click="OnDiscoverClick" IsVisible="{Binding CanDiscover}" />
        </StackPanel>

        <Separator />

        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto">
          <TextBlock Text="{loc:Tr 名称}" Classes="fieldlabel" />
          <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="{loc:Tr 可选，例如：我的服务器}" />
        </Grid>

        <Grid ColumnDefinitions="100,*,86,*">
          <TextBlock Text="{Binding HostLabel}" Classes="fieldlabel" />
          <TextBox x:Name="HostBox" Grid.Column="1" Text="{Binding Host, Mode=TwoWay}" PlaceholderText="{loc:Tr 主机名或 IP 地址}" />
          <TextBlock Grid.Column="2" Text="{loc:Tr 端口}" Classes="fieldlabel" Margin="14,0,10,0" />
          <TextBox Grid.Column="3" Text="{Binding PortText, Mode=TwoWay}" PlaceholderText="{Binding DefaultPortText}" />
        </Grid>

        <Grid ColumnDefinitions="100,*" IsVisible="{Binding ShowAuthFields}">
          <TextBlock Text="{Binding UsernameLabel}" Classes="fieldlabel" />
          <TextBox Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" PlaceholderText="{loc:Tr 登录用户名}" />
        </Grid>

        <StackPanel Spacing="8" IsVisible="{Binding ShowS3Fields}">
          <Grid ColumnDefinitions="100,*">
            <TextBlock Text="{loc:Tr S3 Bucket}" Classes="fieldlabel" />
            <TextBox Grid.Column="1" Text="{Binding S3Bucket, Mode=TwoWay}" PlaceholderText="my-bucket" />
          </Grid>
          <Grid ColumnDefinitions="100,*">
            <TextBlock Text="{loc:Tr S3 区域}" Classes="fieldlabel" />
            <TextBox Grid.Column="1" Text="{Binding S3Region, Mode=TwoWay}" PlaceholderText="us-east-1" />
          </Grid>
          <Grid ColumnDefinitions="100,*">
            <TextBlock Text="{loc:Tr Session Token}" Classes="fieldlabel" />
            <TextBox Grid.Column="1" Text="{Binding S3SessionToken, Mode=TwoWay}"
                     PlaceholderText="{loc:Tr 可选，仅临时凭据需要}" PasswordChar="●" />
          </Grid>
          <CheckBox Content="{loc:Tr 使用路径风格 URL（MinIO、R2 等通常需要）}"
                    IsChecked="{Binding S3UsePathStyle, Mode=TwoWay}" />
          <TextBlock Text="{loc:Tr Access Key 填在用户名，Secret Key 填在密码；Bucket 根目录显示为 /。}"
                     Classes="tiny" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding ShowSshAuth}">
          <TextBlock Text="{loc:Tr 认证方式}" Classes="section" />
          <WrapPanel ItemWidth="110" ItemHeight="34">
            <Button Classes="chip" Tag="Password" Click="OnSshAuthClick"
                    Classes.active="{Binding SshAuth, Converter={StaticResource EqualsConverter}, ConverterParameter=Password}">
              <TextBlock Text="{loc:Tr 密码}" />
            </Button>
            <Button Classes="chip" Tag="PrivateKey" Click="OnSshAuthClick"
                    Classes.active="{Binding SshAuth, Converter={StaticResource EqualsConverter}, ConverterParameter=PrivateKey}">
              <TextBlock Text="{loc:Tr 私钥}" />
            </Button>
            <Button Classes="chip" Tag="Agent" Click="OnSshAuthClick"
                    Classes.active="{Binding SshAuth, Converter={StaticResource EqualsConverter}, ConverterParameter=Agent}">
              <TextBlock Text="{loc:Tr SSH Agent}" />
            </Button>
          </WrapPanel>
        </StackPanel>

        <Grid ColumnDefinitions="100,*" IsVisible="{Binding ShowSecretField}">
          <TextBlock Text="{Binding SecretLabel}" Classes="fieldlabel" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox x:Name="PasswordBox" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●"
                     PlaceholderText="{Binding SecretPlaceholder}" />
            <Button Grid.Column="1" Classes="tool" Width="30" Height="30" Click="OnTogglePasswordClick"
                    ToolTip.Tip="{loc:Tr 显示/隐藏密码}">
              <Path Data="{StaticResource IconEye}" Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource TextSecondaryBrush}" />
            </Button>
          </Grid>
        </Grid>

        <Grid ColumnDefinitions="100,*" IsVisible="{Binding ShowPrivateKeyField}">
          <TextBlock Text="{loc:Tr 私钥文件}" Classes="fieldlabel" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Text="{Binding PrivateKeyPath, Mode=TwoWay}" PlaceholderText="~/.ssh/id_ed25519" />
            <Button Grid.Column="1" Content="{loc:Tr 浏览…}" Click="OnBrowsePrivateKeyClick" />
          </Grid>
        </Grid>

        <TextBlock Text="{loc:Tr 使用 SSH_AUTH_SOCK 中的身份。请先用 ssh-add 添加密钥；Ordoa 不会读取或保存私钥本身。}"
                   Classes="tiny" TextWrapping="Wrap" IsVisible="{Binding ShowAgentHint}" />

        <Grid ColumnDefinitions="100,*" IsVisible="{Binding IsSmb}">
          <TextBlock Text="{loc:Tr 域}" Classes="fieldlabel" />
          <TextBox Grid.Column="1" Text="{Binding Domain, Mode=TwoWay}" PlaceholderText="{loc:Tr 可选，例如 WORKGROUP}" />
        </Grid>

        <Grid ColumnDefinitions="100,*">
          <TextBlock Text="{loc:Tr 初始路径}" Classes="fieldlabel" />
          <TextBox Grid.Column="1" Text="{Binding InitialPath, Mode=TwoWay}"
                   PlaceholderText="{loc:Tr / 或 share/folder（SMB）}" />
        </Grid>

        <TextBlock Text="{loc:Tr 主机密钥会与 ~/.ssh/known_hosts 校验；未知主机首次连接后会记录到连接配置。}"
                   Classes="tiny" TextWrapping="Wrap" IsVisible="{Binding ShowKnownHostsHint}" />
        <TextBlock Text="{loc:Tr SMB 使用 TCP 445 端口；端口设置不会改变实际连接端口。}" Classes="tiny"
                   IsVisible="{Binding IsSmb}" TextWrapping="Wrap" />
        <CheckBox Content="{loc:Tr 匿名登录（仅 FTP）}" IsChecked="{Binding Anonymous, Mode=TwoWay}"
                  IsVisible="{Binding ShowAnonymous}" />
        <CheckBox Content="{Binding SecureLabel}" IsChecked="{Binding Secure, Mode=TwoWay}"
                  IsVisible="{Binding ShowSecureToggle}" />
        <CheckBox Content="{loc:Tr 允许无效或自签名证书（不安全）}" IsChecked="{Binding AllowInvalidCertificate, Mode=TwoWay}"
                  IsVisible="{Binding ShowTlsOptions}" />
        <CheckBox Content="{Binding SaveSecretLabel}" IsChecked="{Binding SavePassword, Mode=TwoWay}"
                  IsVisible="{Binding ShowSaveSecret}" />
        <CheckBox Content="{loc:Tr 在侧栏中保存此连接}" IsChecked="{Binding SaveProfile, Mode=TwoWay}" />

        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,8"
                IsVisible="{Binding ValidationMessage, Converter={StaticResource NotNullConverter}}">
          <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorBrush}"
                     Classes="caption" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="18,10,18,14" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="60" Height="3" IsVisible="{Binding IsTesting}" />
          <TextBlock Text="{Binding TestStatus}" Classes="caption"
                     Classes.testerror="{Binding IsTestError}" VerticalAlignment="Center"
                     MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TestStatus}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Tr 取消}" Click="OnCancelClick" />
          <Button Content="{loc:Tr 测试连接}" Classes="subtle" Click="OnTestClick" IsEnabled="{Binding CanTest}" />
          <Button Content="{loc:Tr 连接}" Classes="accent" Click="OnSaveClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
