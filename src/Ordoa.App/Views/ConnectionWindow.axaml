<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ordoa.App.Views.ConnectionWindow"
        Title="{Binding HeaderTitle}"
        Width="600" Height="690" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.fieldlabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.chip.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.chip.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.testerror">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="22,18,22,12" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
          <Path Data="{StaticResource IconCloud}" Width="22" Height="22" Stretch="Uniform"
                Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding HeaderTitle}" Classes="h2" />
          <TextBlock Text="{Binding HeaderSubtitle}" Classes="caption" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="22,14,22,8" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <StackPanel Spacing="6">
          <TextBlock Text="协议" Classes="section" />
          <WrapPanel ItemWidth="104" ItemHeight="34">
            <Button Classes="chip" Tag="Ftp" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=Ftp}">
              <TextBlock Text="FTP" />
            </Button>
            <Button Classes="chip" Tag="Ftps" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=Ftps}">
              <TextBlock Text="FTPS" />
            </Button>
            <Button Classes="chip" Tag="Sftp" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=Sftp}">
              <TextBlock Text="SFTP" />
            </Button>
            <Button Classes="chip" Tag="Smb" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=Smb}">
              <TextBlock Text="SMB" />
            </Button>
            <Button Classes="chip" Tag="WebDav" Click="OnProtocolClick"
                    Classes.active="{Binding Protocol, Converter={StaticResource EqualsConverter}, ConverterParameter=WebDav}">
              <TextBlock Text="WebDAV" />
            </Button>
          </WrapPanel>
        </StackPanel>

        <Separator />

        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto">
          <TextBlock Text="名称" Classes="fieldlabel" />
          <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="可选，例如：我的服务器" />
        </Grid>

        <Grid ColumnDefinitions="100,*,86,*">
          <TextBlock Text="服务器" Classes="fieldlabel" />
          <TextBox x:Name="HostBox" Grid.Column="1" Text="{Binding Host, Mode=TwoWay}" PlaceholderText="主机名或 IP 地址" />
          <TextBlock Grid.Column="2" Text="端口" Classes="fieldlabel" Margin="14,0,10,0" />
          <TextBox Grid.Column="3" Text="{Binding PortText, Mode=TwoWay}" PlaceholderText="{Binding DefaultPortText}" />
        </Grid>

        <Grid ColumnDefinitions="100,*" IsVisible="{Binding ShowAuthFields}">
          <TextBlock Text="用户名" Classes="fieldlabel" />
          <TextBox Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" PlaceholderText="登录用户名" />
        </Grid>

        <Grid ColumnDefinitions="100,*" IsVisible="{Binding ShowAuthFields}">
          <TextBlock Text="密码" Classes="fieldlabel" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox x:Name="PasswordBox" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●"
                     PlaceholderText="登录密码" />
            <Button Grid.Column="1" Classes="tool" Width="30" Height="30" Click="OnTogglePasswordClick"
                    ToolTip.Tip="显示/隐藏密码">
              <Path Data="{StaticResource IconEye}" Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource TextSecondaryBrush}" />
            </Button>
          </Grid>
        </Grid>

        <Grid ColumnDefinitions="100,*" IsVisible="{Binding IsSmb}">
          <TextBlock Text="域" Classes="fieldlabel" />
          <TextBox Grid.Column="1" Text="{Binding Domain, Mode=TwoWay}" PlaceholderText="可选，例如 WORKGROUP" />
        </Grid>

        <Grid ColumnDefinitions="100,*">
          <TextBlock Text="初始路径" Classes="fieldlabel" />
          <TextBox Grid.Column="1" Text="{Binding InitialPath, Mode=TwoWay}"
                   PlaceholderText="/ 或 share/folder（SMB）" />
        </Grid>

        <TextBlock Text="SMB 使用 TCP 445 端口；端口设置不会改变实际连接端口。" Classes="tiny"
                   IsVisible="{Binding IsSmb}" TextWrapping="Wrap" />
        <CheckBox Content="匿名登录（仅 FTP）" IsChecked="{Binding Anonymous, Mode=TwoWay}"
                  IsVisible="{Binding ShowAnonymous}" />
        <CheckBox Content="使用 HTTPS（WebDAV）" IsChecked="{Binding Secure, Mode=TwoWay}"
                  IsVisible="{Binding IsWebDav}" />
        <CheckBox Content="允许无效或自签名证书（不安全）" IsChecked="{Binding AllowInvalidCertificate, Mode=TwoWay}"
                  IsVisible="{Binding ShowTlsOptions}" />
        <CheckBox Content="保存密码到系统密钥环" IsChecked="{Binding SavePassword, Mode=TwoWay}"
                  IsVisible="{Binding ShowAuthFields}" />
        <CheckBox Content="在侧栏中保存此连接" IsChecked="{Binding SaveProfile, Mode=TwoWay}" />

        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,8"
                IsVisible="{Binding ValidationMessage, Converter={StaticResource NotNullConverter}}">
          <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorBrush}"
                     Classes="caption" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="18,10,18,14" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="60" Height="3" IsVisible="{Binding IsTesting}" />
          <TextBlock Text="{Binding TestStatus}" Classes="caption"
                     Classes.testerror="{Binding IsTestError}" VerticalAlignment="Center"
                     MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TestStatus}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="取消" Click="OnCancelClick" />
          <Button Content="测试连接" Classes="subtle" Click="OnTestClick" IsEnabled="{Binding CanTest}" />
          <Button Content="连接" Classes="accent" Click="OnSaveClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
