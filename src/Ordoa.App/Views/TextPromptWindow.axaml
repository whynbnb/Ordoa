<Window xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Ordoa.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ordoa.App.Views.TextPromptWindow"
        Title="{Binding TitleText}"
        Width="460" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
  <Border Padding="22,20,22,18">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding TitleText}" Classes="h2" />
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Label}" Classes="caption" />
        <TextBox x:Name="ValueBox" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{loc:Tr 输入名称}"
                 FontSize="13" />
        <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource ErrorBrush}"
                   Classes="caption" IsVisible="{Binding ValidationError, Converter={StaticResource NotNullConverter}}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
        <Button Content="{loc:Tr 取消}" Click="OnCancelClick" />
        <Button Content="{Binding ConfirmText}" Classes="accent" Click="OnConfirmClick"
                IsEnabled="{Binding CanConfirm}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
