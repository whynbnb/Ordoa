<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:Ordoa.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ordoa.App.ViewModels.Dialogs"
        x:DataType="vm:DuplicateFinderDialogViewModel"
        x:CompileBindings="True"
        x:Class="Ordoa.App.Views.DuplicateFinderWindow"
        Title="{loc:Tr 查找重复文件}"
        Width="1000" Height="740" MinWidth="760" MinHeight="520" CanResize="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Padding="22,15,22,12" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Tr 查找重复文件}" Classes="h2" />
          <TextBlock Text="{Binding RootPath}" Classes="caption"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Content="{loc:Tr 关闭}" Click="OnCloseClick"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="18,10" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceAltBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{loc:Tr 最小文件大小 (KB)}" Classes="fieldlabel" />
          <NumericUpDown Width="96" Minimum="0" Maximum="1048576" Increment="1"
                         FormatString="0" Value="{Binding MinSizeKb, Mode=TwoWay}" />
          <TextBlock Text="{loc:Tr 修改后重新扫描}" Classes="fieldhint"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
          <Button Content="{loc:Tr 全选重复项}" Classes="subtle"
                  Click="OnSelectAllClick" IsEnabled="{Binding HasGroups}" />
          <Button Content="{loc:Tr 取消选择}" Classes="subtle"
                  Click="OnClearAllClick" IsEnabled="{Binding HasGroups}" />
          <Button Content="{loc:Tr 重新扫描}" Classes="subtle"
                  Click="OnScanClick" IsEnabled="{Binding CanScan}" />
          <Button Content="{loc:Tr 停止}" Classes="subtle"
                  Click="OnStopClick" IsVisible="{Binding IsScanning}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="18,12,18,8">
      <ListBox ItemsSource="{Binding Groups}"
               Background="Transparent" BorderThickness="0"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
            <Border Classes="card" Padding="12,10" Margin="0,0,0,9">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" Classes="tiny" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{loc:Tr 全选重复项}" Classes="link"
                          FontSize="11" Tag="{Binding}" Click="OnSelectGroupDuplicatesClick" />
                  <Button Grid.Column="2" Content="{loc:Tr 取消选择}" Classes="link"
                          FontSize="11" Tag="{Binding}" Click="OnClearGroupClick" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Files}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateFileItem">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,3">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="11.5"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Folder}" Classes="tiny"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="tiny"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="{loc:Tr 没有发现重复文件}" Classes="caption"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding ShowEmptyState}" />
    </Grid>

    <Border Grid.Row="3" Padding="18,10,18,14" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding StatusText}" Classes="caption" />
            <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                         IsVisible="{Binding IsScanning}" />
          </StackPanel>
          <TextBlock Text="{Binding CounterText}" Classes="tiny" />
          <TextBlock Text="{Binding ScanSummary}" Classes="tiny" />
          <TextBlock Text="{Binding GroupsNote}" Classes="tiny"
                     Foreground="{DynamicResource TextTertiaryBrush}" />
          <TextBlock Text="{loc:Tr 当前平台不支持回收站，只能查看结果。}"
                     Classes="tiny" Foreground="{DynamicResource WarningBrush}"
                     IsVisible="{Binding !CanUseTrash}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedSummary}" Classes="caption"
                     VerticalAlignment="Center" />
          <Button Content="{loc:Tr 移到回收站}" Classes="danger" Click="OnDeleteClick"
                  IsEnabled="{Binding CanDelete}" />
          <Button Content="{loc:Tr 关闭}" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
