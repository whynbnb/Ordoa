<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Ordoa.App</RootNamespace>
    <AssemblyName>Ordoa</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets\ordoa.ico</ApplicationIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Ordoa 安序——Linux 优先的极简文件管理器</Description>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Sdcb.SimdCodecs" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ordoa.Core\Ordoa.Core.csproj" />
  </ItemGroup>

  <!-- Optional single-file NativeAOT mode. The package is only restored when
       UseStaticLinkAvalonia is explicitly enabled by the publish script. -->
  <ItemGroup Condition="'$(UseStaticLinkAvalonia)' == 'true'">
    <PackageReference Include="StaticLink.Avalonia" Version="3.119.4.1" />
    <PackageReference Include="StaticLink.Avalonia.Native" Version="12.1.4.1"
                      Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))" />
  </ItemGroup>


  <!-- Reflection bindings are used throughout the XAML. Root the application
       assemblies so NativeAOT keeps the view-model members those bindings need. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="Ordoa" />
    <TrimmerRootAssembly Include="Ordoa.Core" />
    <TrimmerRootAssembly Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
